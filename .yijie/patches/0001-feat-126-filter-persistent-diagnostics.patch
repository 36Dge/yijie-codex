diff --git a/state/src/log_db_filter_tests.rs b/state/src/log_db_filter_tests.rs
index 6c9d75f4d..ad5b372ad 100644
--- a/state/src/log_db_filter_tests.rs
+++ b/state/src/log_db_filter_tests.rs
@@ -48,3 +48,67 @@ async fn sqlite_sink_drops_low_level_opentelemetry_sdk_logs() {
 
     let _ = tokio::fs::remove_dir_all(codex_home).await;
 }
+
+#[tokio::test]
+async fn default_filter_drops_path_bearing_diagnostics_and_keeps_reviewed_state_logs() {
+    let codex_home = std::env::temp_dir().join(format!(
+        "codex-state-log-db-default-filter-{}",
+        Uuid::new_v4()
+    ));
+    let runtime = StateRuntime::init(codex_home.clone(), "test-provider".to_string())
+        .await
+        .expect("initialize runtime");
+    let layer = start(runtime.clone());
+
+    let guard = tracing_subscriber::registry()
+        .with(layer.clone().with_filter(default_filter()))
+        .set_default();
+
+    tracing::error!(target: "codex_app_server", "dropped-root-config-warning");
+    tracing::info!(target: "codex_core::shell_snapshot", "dropped-shell-snapshot");
+    tracing::debug!(
+        target: "codex_core::stream_events_utils",
+        "dropped-stream-diagnostic"
+    );
+    tracing::trace!(
+        target: "codex_http_client::transport",
+        "dropped-http-diagnostic"
+    );
+    tracing::info!(target: "feedback_tags", "dropped-feedback-tags");
+    tracing::trace!(
+        target: "hyper_util::client::legacy::pool",
+        "dropped-http-pool-diagnostic"
+    );
+    tracing::trace!(
+        target: "codex_app_server::message_processor",
+        "retained-reviewed-app-server-log"
+    );
+    tracing::info!(target: "codex_state", "retained-state-log");
+
+    layer.flush().await;
+    drop(guard);
+
+    let logs = runtime
+        .query_logs(&crate::LogQuery::default())
+        .await
+        .expect("query logs after flush");
+    assert_eq!(
+        logs.iter()
+            .map(|row| (
+                row.level.as_str(),
+                row.target.as_str(),
+                row.message.as_deref()
+            ))
+            .collect::<Vec<_>>(),
+        vec![
+            (
+                "TRACE",
+                "codex_app_server::message_processor",
+                Some("retained-reviewed-app-server-log")
+            ),
+            ("INFO", "codex_state", Some("retained-state-log")),
+        ]
+    );
+
+    let _ = tokio::fs::remove_dir_all(codex_home).await;
+}
