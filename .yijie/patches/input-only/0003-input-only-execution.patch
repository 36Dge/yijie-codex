+    pub(crate) async fn thread_input_only_policy_read(
+        &self,
+        params: codex_app_server_protocol::ThreadInputOnlyPolicyReadParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let (_, thread) = self.load_thread(&params.thread_id).await?;
+        let config = thread.config().await;
+        let policy = if config.input_only {
+            // Inspect the live snapshot, not merely the requested ConfigToml.
+            let snapshot = thread.config_snapshot().await;
+            let (filesystem, network) = snapshot.permission_profile.to_runtime_permissions();
+            let instruction_sources = thread.legacy_instruction_sources().await;
+            let mcp = thread.runtime_mcp_config(&config).await;
+            if filesystem.kind != codex_protocol::permissions::FileSystemSandboxKind::Restricted
