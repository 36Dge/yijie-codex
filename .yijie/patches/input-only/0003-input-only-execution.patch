+
+/// Input-only conversations never turn a model-emitted tool item into another
+/// request to the model. Unknown future variants fail closed at this boundary.
+fn input_only_response_event_allowed(event: &ResponseEvent) -> bool {
+    match event {
+        ResponseEvent::OutputItemAdded(item) | ResponseEvent::OutputItemDone(item) => match item {
+            ResponseItem::Message { role, content, .. } => {
+                role == "assistant"
+                    && content.iter().all(|part| {
+                        matches!(part, codex_protocol::models::ContentItem::OutputText { .. })
+                    })
+            }
+            ResponseItem::Reasoning { .. } => true,
+            _ => false,
+        },
+        ResponseEvent::ToolCallInputDelta { .. } => false,
+        _ => true,
+    }
+}
+
+#[cfg(test)]
+mod input_only_response_tests {
+    use super::*;
+
+    #[test]
+    fn input_only_response_rejects_non_text_variants() {
+        let message: ResponseItem = serde_json::from_value(serde_json::json!({
+            "type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "ordinary proposal"}]
+        })).unwrap();
+        assert!(input_only_response_event_allowed(
+            &ResponseEvent::OutputItemAdded(message.clone())
+        ));
+        assert!(input_only_response_event_allowed(
+            &ResponseEvent::OutputItemDone(message)
+        ));
+        // Plain unknown-format compatibility metadata, not an executable or
+        // adversarial payload. No tool, process or network is invoked here.
+        assert!(!input_only_response_event_allowed(
+            &ResponseEvent::OutputItemDone(ResponseItem::Other)
+        ));
+        assert!(!input_only_response_event_allowed(
+            &ResponseEvent::ToolCallInputDelta {
+                item_id: "ordinary-item".into(),
+                call_id: None,
+                delta: String::new(),
+            }
+        ));
+    }
+}
