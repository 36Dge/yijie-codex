+                || network.is_enabled()
+                || snapshot.approval_policy != codex_protocol::protocol::AskForApproval::Never
+                || !instruction_sources.is_empty()
+                || !codex_mcp::configured_mcp_servers(&mcp).is_empty()
+                || mcp.apps_enabled
+            {
+                return Err(internal_error(
+                    "input-only execution restrictions are not intact",
