+// Some providers emit empty assistant text between reasoning or tool items and reject
+// it when replayed. Filter only the request copy, keeping the original transcript.
+fn omit_empty_assistant_messages(input: &mut Vec<ResponseItem>) {
+    input.retain_mut(|item| {
+        let ResponseItem::Message { role, content, .. } = item else {
+            return true;
+        };
+        if role != "assistant" {
+            return true;
+        }
+        content.retain(|part| {
+            !matches!(part, ContentItem::InputText { text } | ContentItem::OutputText { text } if text.is_empty())
+        });
+        content.iter().any(|part| match part {
+            ContentItem::InputText { text } | ContentItem::OutputText { text } => {
+                !text.trim().is_empty()
+            }
+            ContentItem::InputImage { .. } => true,
+        })
+    });
+}
