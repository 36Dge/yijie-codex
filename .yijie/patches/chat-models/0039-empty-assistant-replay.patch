+#[test]
+fn empty_assistant_replay_is_filtered_on_every_model_request() {
+    use serde_json::json;
+
+    let expected: Vec<ResponseItem> = serde_json::from_value(json!([
+        {"type":"message","role":"user","content":[{"type":"input_text","text":"350ml"}]},
+        {"type":"reasoning","summary":[{"type":"summary_text","text":"Check length"}]},
+        {"type":"function_call","name":"exec","arguments":"{}","call_id":"read"},
+        {"type":"function_call_output","call_id":"read","output":""},
+        {"type":"message","role":"developer","content":[{"type":"input_text","text":""}]},
+        {"type":"message","role":"assistant","phase":"commentary","content":[
+            {"type":"output_text","text":"  title"},
+            {"type":"output_text","text":"\n"},
+            {"type":"output_text","text":"body  "}
+        ]},
+        {"type":"message","role":"assistant","content":[{"type":"input_image","image_url":"image-ref"}]}
+    ])).unwrap();
+    let mut history = expected.clone();
+    for index in [5, 6] {
+        let ResponseItem::Message { content, .. } = &mut history[index] else {
+            panic!("expected an assistant message");
+        };
+        content.insert(
+            0,
+            ContentItem::InputText {
+                text: String::new(),
+            },
+        );
+        content.push(ContentItem::OutputText {
+            text: String::new(),
+        });
+    }
+    history.splice(
+        2..2,
+        [
+            output_message("empty", ""),
+            output_message("whitespace", " \n\t"),
+            serde_json::from_value(json!({"type":"message","role":"assistant","content":[]}))
+                .unwrap(),
+        ],
+    );
+    let prompt = Prompt {
+        input: history.clone(),
+        ..Default::default()
+    };
+    for (model, effort) in [
+        ("kimi-k3.1-pro", ReasoningEffort::High),
+        ("kimi-k3.1-pro", ReasoningEffort::Max),
+        ("MiniMax-M3", ReasoningEffort::High),
+        ("another-responses-model", ReasoningEffort::High),
+    ] {
+        let request = request_for_profile(model, effort.clone(), &prompt).unwrap();
+        let body = serde_json::to_value(request).unwrap();
+        assert_eq!(body["model"], model);
+        assert_eq!(body["reasoning"]["effort"], json!(effort));
+        assert_eq!(body["input"], json!(expected), "{model}, {effort:?}");
+        assert_eq!(prompt.input, history);
+    }
+}
