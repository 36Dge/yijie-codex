+// JS code can still inspect the original MCP content or individual chunks.
+// Printing the result (including inside arrays or JSON.stringify) emits one
+// bounded receipt. Only the registered deep-search callback uses this view.
+fn deep_search_value<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    raw: &JsonValue,
+    preview: &JsonValue,
+) -> Result<v8::Local<'s, v8::Value>, String> {
+    let fail = || "failed to construct web search result".to_string();
+    let value = json_to_v8(scope, raw).ok_or_else(fail)?;
+    let object = v8::Local::<v8::Object>::try_from(value).map_err(|_| fail())?;
+    let summary = json_to_v8(scope, preview).ok_or_else(fail)?;
+    let callback = v8::Function::builder(return_model_preview)
+        .data(summary)
+        .build(scope)
+        .ok_or_else(fail)?;
+    let key = v8::String::new(scope, "toJSON").ok_or_else(fail)?;
+    let structured_key = v8::String::new(scope, "structuredContent").ok_or_else(fail)?;
+    let structured = object
+        .get(scope, structured_key.into())
+        .and_then(|v| v8::Local::<v8::Object>::try_from(v).ok());
+    for target in std::iter::once(object).chain(structured) {
+        if target.define_own_property(
+            scope,
+            key.into(),
+            callback.into(),
+            v8::PropertyAttribute::DONT_ENUM,
+        ) != Some(true)
+        {
+            return Err(fail());
+        }
+    }
+    Ok(value)
+}
+
+fn return_model_preview(
+    _scope: &mut v8::PinScope<'_, '_>,
+    args: v8::FunctionCallbackArguments,
+    mut retval: v8::ReturnValue<v8::Value>,
+) {
+    retval.set(args.data());
+}
