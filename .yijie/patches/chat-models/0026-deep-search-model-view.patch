new file mode 100644
index 0000000..677c8df
--- /dev/null
+++ b/core/src/tools/web_search_preview.rs
@@ -0,0 +1,139 @@
+//! Model-visible evidence from one native deep search. Original MCP items
+//! and both programmatic receipt representations remain available to the cell.
+use codex_protocol::mcp::CallToolResult;
+use codex_utils_string::take_bytes_at_char_boundary;
+use serde_json::Value;
+use serde_json::json;
+
+// Three parallel topics, including the cell envelope, must fit the Kimi
+// model's 12 KB tool-output budget even when individual snippets are long.
+const MAX_PREVIEW_BYTES: usize = 3_800;
+
+pub(crate) fn preview(arguments: &Value, result: &CallToolResult) -> Option<Value> {
+    let query = arguments.get("query")?.as_str()?;
+    let structured = result.structured_content.as_ref()?;
+    if let Some(error) = structured.get("error") {
+        return Some(
+            json!({"query": take_bytes_at_char_boundary(query, 512), "isError": true,
+            "error": {"code": error.get("code")?.as_str()?, "message": error.get("message")?.as_str()?}}),
+        );
+    }
+    let rows = structured.get("results")?.as_array()?;
+    if !result.success() || rows.len() > 20 {
+        return None;
+    }
+    let mut view = json!({
+        "query": query, "count": rows.len(), "isError": false,
+        "truncated": structured.get("truncated")?.as_bool()?,
+        "dropped_results": structured.get("dropped_results")?.as_u64()?,
+        "results": []
+    });
+    if result
+        .meta
+        .as_ref()
+        .and_then(|m| m.get("yijie/search-reused"))
+        .and_then(Value::as_bool)
+        == Some(true)
+    {
+        view["reused"] = Value::Bool(true);
+    }
+    let mut sources = Vec::with_capacity(rows.len());
+    for (index, row) in rows.iter().enumerate() {
+        let mut source = json!({"index": index});
+        for field in [
+            "title",
+            "url",
+            "date",
+            "site_name",
+            "snippet",
+            "content_status",
+        ] {
+            source[field] = Value::String(row.get(field)?.as_str()?.to_owned());
+        }
+        sources.push(source);
+    }
+    view["results"] = Value::Array(sources);
+    if view.to_string().len() <= MAX_PREVIEW_BYTES {
+        return Some(view);
+    }
+
+    // Reserve a fair share for every source. Never manufacture a shortened URL.
+    view["preview_truncated"] = Value::Bool(true);
+    view["query"] = json!(take_bytes_at_char_boundary(query, 512));
+    let Value::Array(mut sources) = view["results"].take() else {
+        return None;
+    };
+    let budget = (MAX_PREVIEW_BYTES - view.to_string().len() - 32) / sources.len().max(1);
+    for source in &mut sources {
+        if source.to_string().len() <= budget {
+            continue;
+        }
+        for limit in [256, 128, 64, 32, 0] {
+            for field in ["snippet", "title", "site_name", "date"] {
+                let text = source[field].as_str()?;
+                if text.len() > limit {
+                    source[field] = json!(take_bytes_at_char_boundary(text, limit));
+                }
+            }
+            if source.to_string().len() <= budget {
+                break;
+            }
+            if source["url"]
+                .as_str()
+                .is_some_and(|url| url.len() > budget / 2)
+            {
+                source.as_object_mut()?.remove("url");
+            }
+            if source.to_string().len() <= budget {
+                break;
+            }
+        }
+        if source.to_string().len() > budget {
+            *source = json!({"index": source["index"]});
+        }
+    }
+    view["results"] = Value::Array(sources);
+    Some(view)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn receipt(value: Value) -> CallToolResult {
+        CallToolResult {
+            content: vec![json!({"type":"text","text":value.to_string()})],
+            structured_content: Some(value),
+            is_error: Some(false),
+            meta: None,
+        }
+    }
+
+    #[test]
+    fn deep_search_preview_preserves_sources_and_the_original_receipt() {
+        let value = json!({"results":[{"title":"游船","url":"https://example.org/boat","date":"2026-11-18","site_name":"湖区","snippet":"乘船信息","content_status":"available","chunks":[{"text":"完整片段","score":0.9}]}],"truncated":false,"dropped_results":0});
+        let result = receipt(value.clone());
+        let output = preview(&json!({"query":"游船票价"}), &result).unwrap();
+        assert_eq!(output["query"], "游船票价");
+        assert_eq!(output["count"], 1);
+        assert_eq!(output["results"][0]["url"], value["results"][0]["url"]);
+        assert!(output["results"][0].get("chunks").is_none());
+        assert_eq!(result.structured_content, Some(value));
+    }
+
+    #[test]
+    fn deep_search_preview_shares_budget_across_all_sources() {
+        let row = json!({"title":"公开文章".repeat(70),"url":format!("https://example.org/{}", "topic".repeat(200)),"date":"2026-11-18","site_name":"文档","snippet":"来源摘要".repeat(320),"content_status":"truncated"});
+        let output = preview(
+            &json!({"query":"杭州"}),
+            &receipt(json!({"results":vec![row;20],"truncated":true,"dropped_results":2})),
+        )
+        .unwrap();
+        assert!(output.to_string().len() <= MAX_PREVIEW_BYTES);
+        assert_eq!(output["results"].as_array().unwrap().len(), 20);
+        assert_eq!(output["results"][19]["index"], 19);
+        assert_eq!(output["preview_truncated"], true);
+        assert_eq!(output["truncated"], true);
+        assert_eq!(output["dropped_results"], 2);
+    }
+}
