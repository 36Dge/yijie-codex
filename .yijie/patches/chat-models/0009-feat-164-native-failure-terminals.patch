+#[cfg(test)]
+mod feat164_tests {
+    use super::*;
+    use codex_protocol::protocol::{
+        CodexErrorInfo, ErrorEvent, TurnAbortReason, TurnAbortedEvent, TurnCompleteEvent,
+        TurnStartedEvent,
+    };
+
+    fn complete() -> EventMsg {
+        EventMsg::TurnComplete(TurnCompleteEvent {
+            turn_id: "local-turn".into(),
+            last_agent_message: None,
+            completed_at: None,
+            duration_ms: None,
+            time_to_first_token_ms: None,
+        })
+    }
+    #[test]
+    fn feat164_failure_survives_completion_and_next_turn_resets() {
+        let failed = agent_status_after_event(
+            &AgentStatus::Running,
+            &EventMsg::Error(ErrorEvent {
+                message: "ordinary local rejection".into(),
+                codex_error_info: Some(CodexErrorInfo::BadRequest),
+            }),
+        )
+        .unwrap();
+        assert!(matches!(failed, AgentStatus::Errored(_)));
+        assert!(agent_status_after_event(&failed, &complete()).is_none());
+        let started = EventMsg::TurnStarted(TurnStartedEvent {
+            turn_id: "next-turn".into(),
+            trace_id: None,
+            started_at: None,
+            model_context_window: None,
+            collaboration_mode_kind: Default::default(),
+        });
+        let running = agent_status_after_event(&failed, &started).unwrap();
+        assert!(matches!(running, AgentStatus::Running));
+        assert!(matches!(
+            agent_status_after_event(&running, &complete()),
+            Some(AgentStatus::Completed(None))
+        ));
+    }
+    #[test]
+    fn feat164_non_turn_error_and_cancel_keep_native_meaning() {
+        let error = EventMsg::Error(ErrorEvent {
+            message: "ordinary rollback request rejected".into(),
+            codex_error_info: Some(CodexErrorInfo::ThreadRollbackFailed),
+        });
+        assert!(agent_status_after_event(&AgentStatus::Running, &error).is_none());
+        let cancelled = EventMsg::TurnAborted(TurnAbortedEvent {
+            turn_id: Some("local-turn".into()),
+            reason: TurnAbortReason::Interrupted,
+            completed_at: None,
+            duration_ms: None,
+        });
+        assert!(matches!(
+            agent_status_after_event(&AgentStatus::Errored("local".into()), &cancelled),
+            Some(AgentStatus::Interrupted)
+        ));
+        assert!(matches!(
+            agent_status_after_event(&AgentStatus::Running, &EventMsg::ShutdownComplete),
+            Some(AgentStatus::Shutdown)
+        ));
+    }
+}
