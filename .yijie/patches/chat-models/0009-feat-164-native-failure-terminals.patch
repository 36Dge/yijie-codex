+/// Retain the native failure fact without retaining provider/error prose.
+/// The existing ErrorEvent shape is understood by retained history readers.
+pub(crate) fn safe_persisted_rollout_item(item: &RolloutItem) -> RolloutItem {
+    match item {
+        RolloutItem::EventMsg(EventMsg::Error(error)) => {
+            RolloutItem::EventMsg(EventMsg::Error(codex_protocol::protocol::ErrorEvent {
+                message: "Turn failed; error details were not retained.".into(),
+                codex_error_info: error.codex_error_info.clone(),
+            }))
+        }
+        _ => item.clone(),
+    }
+}
