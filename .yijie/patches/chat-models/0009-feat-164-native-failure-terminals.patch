+#[cfg(test)]
+mod feat164_tests {
+    use super::*;
+    use codex_protocol::protocol::{CodexErrorInfo, ErrorEvent};
+    #[test]
+    fn feat164_persisted_error_is_safe_in_both_history_modes_and_metrics_paths() {
+        let raw = RolloutItem::EventMsg(EventMsg::Error(ErrorEvent {
+            message: "ordinary local fixture detail".into(),
+            codex_error_info: Some(CodexErrorInfo::BadRequest),
+        }));
+        for mode in [ThreadHistoryMode::Legacy, ThreadHistoryMode::Paginated] {
+            let plain = persisted_rollout_items(std::slice::from_ref(&raw), mode);
+            let (measured, metrics) = crate::persistence_metrics::measure_and_filter_rollout_items(
+                std::slice::from_ref(&raw),
+                mode,
+            );
+            assert_eq!(plain.len(), 1);
+            assert_eq!(
+                serde_json::to_value(&plain).unwrap(),
+                serde_json::to_value(&measured).unwrap()
+            );
+            let RolloutItem::EventMsg(EventMsg::Error(error)) = &plain[0] else {
+                panic!("failure fact lost");
+            };
+            assert_eq!(
+                error.message,
+                "Turn failed; error details were not retained."
+            );
+            assert_eq!(error.codex_error_info, Some(CodexErrorInfo::BadRequest));
+            assert_eq!(metrics.post_filter.items, 1);
+            assert!(
+                !serde_json::to_string(&plain)
+                    .unwrap()
+                    .contains("ordinary local fixture detail")
+            );
+        }
+        let RolloutItem::EventMsg(EventMsg::Error(error)) = raw else {
+            unreachable!()
+        };
+        assert_eq!(error.message, "ordinary local fixture detail");
+    }
+    #[test]
+    fn feat164_non_turn_errors_stay_transient() {
+        for info in [
+            CodexErrorInfo::ThreadRollbackFailed,
+            CodexErrorInfo::ActiveTurnNotSteerable {
+                turn_kind: codex_protocol::protocol::NonSteerableTurnKind::Compact,
+            },
+        ] {
+            let error = RolloutItem::EventMsg(EventMsg::Error(ErrorEvent {
+                message: "ordinary request refused".into(),
+                codex_error_info: Some(info),
+            }));
+            assert!(persisted_rollout_items(&[error], ThreadHistoryMode::Legacy).is_empty());
+        }
+    }
+}
