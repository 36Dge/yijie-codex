diff --git a/core/src/session/publication.rs b/core/src/session/publication.rs
new file mode 100644
--- /dev/null
+++ b/core/src/session/publication.rs
@@ -0,0 +1,452 @@
+//! Publication decisions for the negotiated desktop projection. Provider items,
+//! tool dispatch, mailbox semantics and the sampling loop remain independent.
+use std::sync::Arc;
+
+use codex_protocol::items::{
+    AgentMessageContent, AgentMessageItem, PublicMessagePublication, PublicPhaseSource as Source,
+    TurnItem,
+};
+use codex_protocol::models::MessagePhase;
+use codex_protocol::protocol::{
+    AgentMessageContentDeltaEvent, EventMsg, ItemCompletedEvent, ItemStartedEvent, SessionSource,
+};
+use tokio::sync::Mutex;
+
+use super::{Session, turn_context::TurnContext};
+
+pub(crate) const MARKER: &str = "[yijie-publication-v2]";
+const MAX_ITEM_BYTES: usize = 256 * 1024;
+const MAX_PENDING_BYTES: usize = 2 * 1024 * 1024;
+const MAX_PENDING_ITEMS: usize = 128;
+const CHUNK_BYTES: usize = 16 * 1024;
+
+pub(crate) fn enabled(turn: &TurnContext) -> bool {
+    super::public_messages::enabled(turn)
+        && !turn.realtime_active
+        && !matches!(
+            turn.session_source,
+            SessionSource::SubAgent(_) | SessionSource::Internal(_)
+        )
+        && turn
+            .developer_instructions
+            .as_deref()
+            .is_some_and(|s| s.lines().any(|l| l == MARKER))
+}
+
+#[derive(Default, Clone, Copy, PartialEq)]
+enum Purpose {
+    #[default]
+    Mixed,
+    Progress,
+    Delivery,
+}
+
+struct Candidate {
+    item: AgentMessageItem,
+    stamp: PublicMessagePublication,
+    start_ms: i64,
+    done_ms: Option<i64>,
+    preview: String,
+    published: Option<MessagePhase>,
+    provider_phase: Option<MessagePhase>,
+}
+
+#[derive(Default)]
+pub(crate) struct State {
+    pending: Vec<Candidate>,
+    order: u32,
+    previous: Option<String>,
+    selected: Option<String>,
+    purpose: Purpose,
+    completing: Option<(String, Option<MessagePhase>)>,
+}
+
+fn state(turn: &TurnContext) -> Arc<Mutex<State>> {
+    turn.extension_data
+        .get_or_init(|| Mutex::new(State::default()))
+}
+
+fn take_prefix(text: &str, limit: usize) -> &str {
+    let mut end = text.len().min(limit);
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    &text[..end]
+}
+
+fn text(item: &AgentMessageItem) -> String {
+    item.content
+        .iter()
+        .map(|AgentMessageContent::Text { text }| text.as_str())
+        .collect()
+}
+
+fn set_text(item: &mut AgentMessageItem, text: String) {
+    item.content = vec![AgentMessageContent::Text { text }];
+}
+
+impl State {
+    fn reserve(&mut self, id: &str) -> PublicMessagePublication {
+        let stamp = PublicMessagePublication {
+            item_id: id.to_owned(),
+            order: self.order,
+            after_item_id: self.previous.replace(id.to_owned()),
+            source: Source::Superseded,
+            truncated: false,
+        };
+        self.order = self.order.saturating_add(1);
+        stamp
+    }
+    fn bytes(&self) -> usize {
+        self.pending.iter().map(|m| m.preview.len()).sum()
+    }
+
+    fn held_events(
+        &self,
+        mut m: Candidate,
+        phase: Option<MessagePhase>,
+        source: Source,
+        at: i64,
+        turn: &TurnContext,
+        sess: &Session,
+    ) -> Vec<EventMsg> {
+        if m.preview.trim().is_empty() {
+            return Vec::new();
+        }
+        m.stamp.source = source;
+        m.item.phase = phase;
+        m.item.publication = Some(m.stamp);
+        let mut start = m.item.clone();
+        set_text(&mut start, String::new());
+        let mut events = vec![EventMsg::ItemStarted(ItemStartedEvent {
+            thread_id: sess.thread_id,
+            turn_id: turn.sub_id.clone(),
+            item: TurnItem::AgentMessage(start),
+            started_at_ms: m.start_ms,
+        })];
+        if !source.is_undelivered() {
+            let mut rest = m.preview.as_str();
+            while !rest.is_empty() {
+                let part = take_prefix(rest, CHUNK_BYTES);
+                events.push(EventMsg::AgentMessageContentDelta(
+                    AgentMessageContentDeltaEvent {
+                        thread_id: sess.thread_id.to_string(),
+                        turn_id: turn.sub_id.clone(),
+                        item_id: m.item.id.clone(),
+                        delta: part.into(),
+                    },
+                ));
+                rest = &rest[part.len()..];
+            }
+        }
+        set_text(&mut m.item, m.preview);
+        events.push(EventMsg::ItemCompleted(ItemCompletedEvent {
+            thread_id: sess.thread_id,
+            turn_id: turn.sub_id.clone(),
+            item: TurnItem::AgentMessage(m.item),
+            completed_at_ms: m.done_ms.unwrap_or(at),
+        }));
+        events
+    }
+
+    fn resolve_held(
+        &mut self,
+        sess: &Session,
+        turn: &TurnContext,
+        work: bool,
+        terminal: Option<Source>,
+        at: i64,
+    ) -> Vec<EventMsg> {
+        let mut events = Vec::new();
+        let pending = std::mem::take(&mut self.pending);
+        for m in pending {
+            if m.published.is_some() {
+                // Already streamed. Never synthesize completion of a live item.
+                if terminal.is_none() {
+                    self.pending.push(m);
+                }
+                continue;
+            }
+            let (phase, source) = if work && m.done_ms.is_some() {
+                (Some(MessagePhase::Commentary), Source::SubsequentWork)
+            } else if terminal == Some(Source::TurnCommit)
+                && self.selected.as_deref() == Some(m.item.id.as_str())
+                && m.done_ms.is_some()
+            {
+                (Some(MessagePhase::FinalAnswer), if m.item.phase == Some(MessagePhase::FinalAnswer) {
+                    Source::Declaration
+                } else { Source::TurnCommit })
+            } else if let Some(reason) = terminal {
+                (
+                    None,
+                    if reason == Source::TurnCommit {
+                        Source::Superseded
+                    } else {
+                        reason
+                    },
+                )
+            } else {
+                self.pending.push(m);
+                continue;
+            };
+            events.extend(self.held_events(m, phase, source, at, turn, sess));
+        }
+        events
+    }
+
+    fn start(
+        &mut self,
+        sess: &Session,
+        turn: &TurnContext,
+        mut start: ItemStartedEvent,
+    ) -> Vec<EventMsg> {
+        let TurnItem::AgentMessage(item) = &mut start.item else {
+            let id = start.item.id();
+            if self.previous.as_deref() != Some(&id) {
+                self.reserve(&id);
+            }
+            return vec![EventMsg::ItemStarted(start)];
+        };
+        if self.pending.iter().any(|m| m.item.id == item.id) {
+            return Vec::new();
+        }
+        let mut events = Vec::new();
+        if self.pending.len() >= MAX_PENDING_ITEMS {
+            // Never evict already-published active identities; the native stream
+            // has one active assistant item per response.
+            if let Some(i) = self.pending.iter().position(|m| m.published.is_none()) {
+                let old = self.pending.remove(i);
+                events.extend(self.held_events(
+                    old,
+                    None,
+                    Source::DisplayLimit,
+                    start.started_at_ms,
+                    turn,
+                    sess,
+                ));
+            }
+        }
+        let mut stamp = self.reserve(&item.id);
+        let provider_phase = match self.completing.as_ref() {
+            Some((id, phase)) if id == &item.id => phase.clone(),
+            _ => item.phase.clone(),
+        };
+        let phase = match (provider_phase.clone(), self.purpose) {
+            (Some(phase), _) => Some((phase, Source::Provider)),
+            (_, Purpose::Progress) => Some((MessagePhase::Commentary, Source::ProgressStep)),
+            (_, Purpose::Delivery) => Some((MessagePhase::FinalAnswer, Source::FinalStep)),
+            _ => None,
+        };
+        if let Some((p, origin)) = &phase {
+            stamp.source = *origin;
+            item.publication = Some(stamp.clone());
+            item.phase = Some(p.clone());
+        }
+        let body = text(item);
+        let preview = take_prefix(
+            &body,
+            MAX_ITEM_BYTES.min(MAX_PENDING_BYTES.saturating_sub(self.bytes())),
+        )
+        .to_owned();
+        stamp.truncated = preview.len() < body.len();
+        let mut snapshot = item.clone();
+        set_text(&mut snapshot, String::new());
+        self.pending.push(Candidate {
+            item: snapshot,
+            stamp,
+            preview,
+            start_ms: start.started_at_ms,
+            done_ms: None,
+            provider_phase,
+            published: phase.map(|(p, _)| p),
+        });
+        if item.publication.is_some() {
+            events.push(EventMsg::ItemStarted(start));
+        }
+        events
+    }
+
+    fn route(
+        &mut self,
+        sess: &Session,
+        turn: &TurnContext,
+        msg: EventMsg,
+        succeeded: bool,
+    ) -> Vec<EventMsg> {
+        match msg {
+            EventMsg::ItemStarted(e) => self.start(sess, turn, e),
+            EventMsg::AgentMessageContentDelta(d) => {
+                let remaining = MAX_PENDING_BYTES.saturating_sub(self.bytes());
+                let Some(m) = self.pending.iter_mut().find(|m| m.item.id == d.item_id) else {
+                    return Vec::new();
+                };
+                let part = take_prefix(
+                    &d.delta,
+                    remaining.min(MAX_ITEM_BYTES.saturating_sub(m.preview.len())),
+                );
+                m.preview.push_str(part);
+                m.stamp.truncated |= part.len() != d.delta.len();
+                if m.published.is_some() {
+                    vec![EventMsg::AgentMessageContentDelta(d)]
+                } else {
+                    Vec::new()
+                }
+            }
+            EventMsg::ItemCompleted(mut e) => {
+                let TurnItem::AgentMessage(item) = &mut e.item else {
+                    return vec![EventMsg::ItemCompleted(e)];
+                };
+                let mut output = Vec::new();
+                if !self.pending.iter().any(|m| m.item.id == item.id) {
+                    // Done-only streams still have an explicit first public event.
+                    let mut seed = item.clone();
+                    set_text(&mut seed, String::new());
+                    seed.phase = None;
+                    output.extend(self.start(
+                        sess,
+                        turn,
+                        ItemStartedEvent {
+                            thread_id: e.thread_id,
+                            turn_id: e.turn_id.clone(),
+                            item: TurnItem::AgentMessage(seed),
+                            started_at_ms: e.completed_at_ms,
+                        },
+                    ));
+                }
+                let i = self
+                    .pending
+                    .iter()
+                    .position(|m| m.item.id == item.id)
+                    .expect("just reserved");
+                let mut m = self.pending.remove(i);
+                let body = text(item);
+                let visible = take_prefix(
+                    &body,
+                    MAX_ITEM_BYTES.min(MAX_PENDING_BYTES.saturating_sub(self.bytes())),
+                );
+                m.preview = visible.to_owned();
+                m.stamp.truncated |= visible.len() != body.len();
+                m.done_ms = Some(e.completed_at_ms);
+                if let Some(phase) = m.published {
+                    item.phase = Some(phase);
+                    item.publication = Some(m.stamp);
+                    output.push(EventMsg::ItemCompleted(e));
+                } else {
+                    m.item = item.clone();
+                    set_text(&mut m.item, String::new());
+                    if self.completing.as_ref().is_some_and(|(id, phase)| id == &item.id && phase.is_some()) {
+                        let phase = item.phase.clone();
+                        output.extend(self.held_events(m, phase, Source::Provider, e.completed_at_ms, turn, sess));
+                    } else if item.phase == Some(MessagePhase::Commentary) {
+                        let source = if m.provider_phase.is_some() {
+                            Source::Provider
+                        } else {
+                            Source::Declaration
+                        };
+                        output.extend(self.held_events(
+                            m,
+                            Some(MessagePhase::Commentary),
+                            source,
+                            e.completed_at_ms,
+                            turn,
+                            sess,
+                        ));
+                    } else {
+                        self.pending.insert(i, m);
+                    }
+                }
+                self.completing = None;
+                output
+            }
+            msg @ (EventMsg::TurnAborted(_) | EventMsg::TurnComplete(_)) => {
+                let reason = if matches!(msg, EventMsg::TurnAborted(_)) {
+                    Source::Interrupted
+                } else if succeeded {
+                    Source::TurnCommit
+                } else {
+                    Source::Failed
+                };
+                let mut events = self.resolve_held(
+                    sess,
+                    turn,
+                    false,
+                    Some(reason),
+                    chrono::Utc::now().timestamp_millis(),
+                );
+                events.push(msg);
+                events
+            }
+            msg => vec![msg],
+        }
+    }
+}
+
+pub(crate) async fn dispatch(sess: &Session, turn: &TurnContext, msg: EventMsg) {
+    let success =
+        !matches!(msg, EventMsg::TurnComplete(_)) || turn.terminal_error.lock().await.is_none();
+    let cell = state(turn);
+    let mut state = cell.lock().await;
+    for event in state.route(sess, turn, msg, success) {
+        sess.send_event_direct(turn, event).await;
+    }
+}
+
+pub(crate) async fn begin_attempt(sess: &Session, turn: &TurnContext) {
+    if !enabled(turn) {
+        return;
+    }
+    let cell = state(turn);
+    let mut state = cell.lock().await;
+    for event in state.resolve_held(
+        sess,
+        turn,
+        false,
+        Some(Source::Superseded),
+        chrono::Utc::now().timestamp_millis(),
+    ) {
+        sess.send_event_direct(turn, event).await;
+    }
+    state.selected = None;
+    state.completing = None;
+    // The final bounded answer-only request cannot be replaced by another recovery.
+    state.purpose = if super::answer_completion::last_delivery_attempt(turn) {
+        Purpose::Delivery
+    } else if turn
+        .developer_instructions
+        .as_deref()
+        .is_some_and(|s| s.lines().any(|l| l == "[yijie-public-progress-only-v2]"))
+    {
+        Purpose::Progress
+    } else {
+        Purpose::Mixed
+    };
+}
+
+pub(crate) async fn observe_done(turn: &TurnContext, id: String, provider_phase: Option<MessagePhase>) {
+    if enabled(turn) {
+        state(turn).lock().await.completing = Some((id, provider_phase));
+    }
+}
+
+pub(crate) async fn before_work(sess: &Session, turn: &TurnContext) {
+    if !enabled(turn) {
+        return;
+    }
+    let cell = state(turn);
+    let mut state = cell.lock().await;
+    for event in state.resolve_held(
+        sess,
+        turn,
+        true,
+        None,
+        chrono::Utc::now().timestamp_millis(),
+    ) {
+        sess.send_event_direct(turn, event).await;
+    }
+}
+
+pub(crate) async fn select(turn: &TurnContext, id: Option<String>) {
+    if enabled(turn) {
+        state(turn).lock().await.selected = id;
+    }
+}
