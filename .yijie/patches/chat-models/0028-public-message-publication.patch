+/// Durable source of a published Yijie message, shared by live and rebuilt views.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "snake_case")]
+pub enum PublicPhaseSource {
+    Provider,
+    Declaration,
+    SubsequentWork,
+    TurnCommit,
+    ProgressStep,
+    FinalStep,
+    Interrupted,
+    Failed,
+    Superseded,
+    DisplayLimit,
+}
+
+impl PublicPhaseSource {
+    pub fn is_undelivered(self) -> bool {
+        matches!(
+            self,
+            Self::Interrupted | Self::Failed | Self::Superseded | Self::DisplayLimit
+        )
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema, TS)]
