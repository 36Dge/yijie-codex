+//! Replay provider messages to the ordinary stream only after they can be
+//! distinguished from the last progress update already sent to this user.
+use super::{
+    PendingMessage, PrefixResult, StreamAdapter, assistant_text, prefix, project_item,
+    with_public_text,
+};
+use crate::client_common::ResponseEvent;
+use codex_protocol::models::{MessagePhase, ResponseItem};
+
+use std::sync::Arc;
+
+pub(crate) struct ReviewStream {
+    pub(crate) published: Vec<Arc<str>>,
+    decision: bool,
+    pending: Option<PendingMessage>,
+    forwarded: bool,
+}
+
+pub(crate) fn body(text: &str) -> String {
+    text.trim().replace("\r\n", "\n").replace('\r', "\n")
+}
+
+impl ReviewStream {
+    pub(crate) fn new(published: Vec<Arc<str>>, decision: bool) -> Self {
+        Self {
+            published,
+            decision,
+            pending: None,
+            forwarded: false,
+        }
+    }
+
+    fn could_repeat(&self, message: &PendingMessage) -> bool {
+        let ResponseItem::Message { phase: native, .. } = &message.added else {
+            return false;
+        };
+        if native.as_ref() == Some(&MessagePhase::FinalAnswer) {
+            return false;
+        }
+        let (phase, text) = match prefix(&message.prefix, false) {
+            PrefixResult::Pending => return true,
+            PrefixResult::Envelope { phase, body } => {
+                (native.as_ref().or(phase.as_ref()).cloned(), body)
+            }
+            PrefixResult::Plain(text) => (native.clone(), text),
+        };
+        phase == Some(MessagePhase::Commentary) && {
+            let prefix = body(text);
+            self.published
+                .iter()
+                .any(|prior| prior.starts_with(&prefix))
+        }
+    }
+
+    fn release_if_new(&mut self, public: &mut StreamAdapter) {
+        if !self.decision
+            && self.pending.as_ref().is_some_and(|m| !self.could_repeat(m))
+            && let Some(m) = self.pending.take()
+        {
+            self.forwarded = true;
+            public.push(ResponseEvent::OutputItemAdded(with_public_text(
+                &m.added, None, &m.prefix,
+            )));
+        }
+    }
+
+    fn private_or_repeated(&self, item: &ResponseItem) -> bool {
+        let projected = project_item(true, item);
+        let Some(text) = assistant_text(&projected) else {
+            return false;
+        };
+        let ResponseItem::Message { phase, .. } = projected else {
+            return false;
+        };
+        if phase == Some(MessagePhase::Commentary) {
+            let body = body(&text);
+            if self.published.iter().any(|prior| prior.as_ref() == body) {
+                return true;
+            }
+        }
+        // The control reply is private even if the provider assigns it a phase.
+        // A real, explicitly declared final or changed progress is still usable.
+        self.decision
+            && (phase.is_none()
+                || serde_json::from_str::<serde_json::Value>(&text).is_ok_and(|v| {
+                    v.as_object()
+                        .is_some_and(|object| object.contains_key("next"))
+                }))
+    }
+
+    /// A returned item is persisted unchanged as provider output. It never
+    /// creates a native public start, preview, delta or completed message.
+    pub(crate) fn push(
+        &mut self,
+        event: ResponseEvent,
+        public: &mut StreamAdapter,
+    ) -> Option<ResponseItem> {
+        if !self.decision && self.published.is_empty() {
+            public.push(event);
+            return None;
+        }
+        match event {
+            ResponseEvent::OutputItemAdded(item) => {
+                self.forwarded = false;
+                self.pending = None;
+                if let Some(text) = assistant_text(&item) {
+                    self.pending = Some(PendingMessage {
+                        added: item,
+                        prefix: text,
+                    });
+                    self.release_if_new(public);
+                } else {
+                    public.push(ResponseEvent::OutputItemAdded(item));
+                }
+            }
+            ResponseEvent::OutputTextDelta(_) if self.decision => {}
+            ResponseEvent::OutputTextDelta(delta) if self.pending.is_some() => {
+                if let Some(pending) = &mut self.pending {
+                    // For a long ambiguous prefix the authoritative done item
+                    // supplies the complete text without building a second copy.
+                    if pending.prefix.len() < 16_384 {
+                        pending.prefix.push_str(&delta);
+                        self.release_if_new(public);
+                    }
+                }
+            }
+            ResponseEvent::OutputItemDone(item) => {
+                self.pending = None;
+                let already_streamed = std::mem::take(&mut self.forwarded);
+                if !already_streamed && self.private_or_repeated(&item) {
+                    return Some(item);
+                }
+                public.push(ResponseEvent::OutputItemDone(item));
+            }
+            other => public.push(other),
+        }
+        None
+    }
+}
