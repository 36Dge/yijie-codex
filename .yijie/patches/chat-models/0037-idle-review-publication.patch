+fn decision_schema() -> serde_json::Value {
+    serde_json::json!({
+        "type": "object",
+        "properties": {"next": {"type": "string", "enum": ["answer"]}},
+        "required": ["next"],
+        "additionalProperties": false
+    })
+}
+
+pub(crate) fn review_stream(
+    turn: &TurnContext,
+    schema: Option<&serde_json::Value>,
+) -> public_messages::review::ReviewStream {
+    let decision = enabled(turn) && schema.is_some_and(|value| *value == decision_schema());
+    public_messages::review::ReviewStream::new(published_progress(turn), decision)
+}
+
+pub(crate) fn published_progress(turn: &TurnContext) -> Vec<std::sync::Arc<str>> {
+    if !enabled(turn) {
+        return Vec::new();
+    }
+    with_state(turn, |state| {
+        if state.searched {
+            state.published_progress.iter().cloned().collect()
+        } else {
+            Vec::new()
+        }
+    })
+}
+
+pub(crate) fn published(turn: &TurnContext, message: &codex_protocol::items::AgentMessageItem) {
+    use codex_protocol::items::AgentMessageContent;
+    use codex_protocol::models::MessagePhase;
+    if message.phase != Some(MessagePhase::Commentary) || !enabled(turn) {
+        return;
+    }
+    let text: String = message
+        .content
+        .iter()
+        .map(|part| match part {
+            AgentMessageContent::Text { text } => text.as_str(),
+        })
+        .collect();
+    let body = public_messages::review::body(&text);
+    // Match full published text only. Keep the same bounded text budget as
+    // native publication and never mistake a truncated prefix for equality.
+    const BUDGET: usize = 2 * 1024 * 1024;
+    if body.is_empty()
+        || body.len() > BUDGET
+        || message.publication.as_ref().is_some_and(|p| p.truncated)
+    {
+        return;
+    }
+    with_state(turn, |state| {
+        let seen = &mut state.published_progress;
+        if seen.iter().any(|s| s.as_ref() == body) {
+            return;
+        }
+        let mut bytes: usize = seen.iter().map(|s| s.len()).sum();
+        while seen.len() >= MAX_KEYS || bytes + body.len() > BUDGET {
+            let Some(old) = seen.pop_front() else { break };
+            bytes -= old.len();
+        }
+        seen.push_back(body.into());
+    });
 }
 
