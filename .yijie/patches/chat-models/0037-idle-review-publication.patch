+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::models::ContentItem;
+    fn message(text: &str, phase: Option<MessagePhase>) -> ResponseItem {
+        ResponseItem::Message {
+            id: Some("review-item".into()),
+            role: "assistant".into(),
+            content: vec![ContentItem::OutputText { text: text.into() }],
+            phase,
+            internal_chat_message_metadata_passthrough: None,
+        }
+    }
+    const COMMENT: &str = "[[yijie-public-message-v1:commentary]]\n";
+    #[test]
+    fn identical_declared_progress_never_starts_and_a_changed_tail_is_streamed_in_full() {
+        let mut public = StreamAdapter::new(true);
+        let mut review = ReviewStream::new(vec!["earlier".into(), "forecast".into()], false);
+        for tail in ["", " tomorrow"] {
+            assert!(
+                review
+                    .push(
+                        ResponseEvent::OutputItemAdded(message("", None)),
+                        &mut public
+                    )
+                    .is_none()
+            );
+            for prefix in [
+                "[[yijie-public-",
+                "message-v1:commentary]]\n",
+                "fore",
+                "cast",
+            ] {
+                assert!(
+                    review
+                        .push(ResponseEvent::OutputTextDelta(prefix.into()), &mut public)
+                        .is_none()
+                );
+                assert!(public.pop().is_none());
+            }
+            if !tail.is_empty() {
+                assert!(
+                    review
+                        .push(ResponseEvent::OutputTextDelta(tail.into()), &mut public)
+                        .is_none()
+                );
+                assert!(matches!(
+                    public.pop(),
+                    Some((ResponseEvent::OutputItemAdded(_), _))
+                ));
+                assert!(
+                    matches!(public.pop(), Some((ResponseEvent::OutputTextDelta(t),_)) if t=="forecast tomorrow")
+                );
+            }
+            let raw = message(&format!("{COMMENT}forecast{tail}"), None);
+            let withheld = review.push(ResponseEvent::OutputItemDone(raw.clone()), &mut public);
+            if tail.is_empty() {
+                assert_eq!(withheld, Some(raw));
+                assert!(public.pop().is_none());
+            } else {
+                assert!(withheld.is_none());
+                assert!(matches!(
+                    public.pop(),
+                    Some((ResponseEvent::OutputItemDone(_), _))
+                ));
+            }
+        }
+    }
+    #[test]
+    fn private_decision_and_provider_repeat_stay_private_but_a_final_keeps_its_identity() {
+        let mut review = ReviewStream::new(vec!["forecast".into()], true);
+        let mut public = StreamAdapter::new(true);
+        for (text, phase) in [
+            (r#"{"next":"answer"}"#, Some(MessagePhase::FinalAnswer)),
+            ("forecast", Some(MessagePhase::Commentary)),
+        ] {
+            let raw = message(text, phase);
+            assert_eq!(
+                review.push(ResponseEvent::OutputItemDone(raw.clone()), &mut public),
+                Some(raw)
+            );
+            assert!(public.pop().is_none());
+        }
+        let answer_json = message(r#"{"weather":"clear"}"#, Some(MessagePhase::FinalAnswer));
+        assert!(
+            review
+                .push(
+                    ResponseEvent::OutputItemDone(answer_json.clone()),
+                    &mut public
+                )
+                .is_none()
+        );
+        assert!(
+            matches!(public.pop(), Some((ResponseEvent::OutputItemDone(actual), _)) if actual == answer_json)
+        );
+        let final_item = message("forecast", Some(MessagePhase::FinalAnswer));
+        assert!(
+            review
+                .push(
+                    ResponseEvent::OutputItemDone(final_item.clone()),
+                    &mut public
+                )
+                .is_none()
+        );
+        assert!(
+            matches!(public.pop(),Some((ResponseEvent::OutputItemDone(actual),_)) if actual==final_item)
+        );
+    }
+}
