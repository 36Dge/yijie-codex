+pub(crate) fn host_image_backend(
+    outgoing: Arc<OutgoingMessageSender>,
+    state: ThreadStateManager,
+) -> codex_image_generation_extension::HostImageBackend {
+    let outgoing = Arc::downgrade(&outgoing);
+    Arc::new(move |call| {
+        let outgoing = outgoing.clone();
+        let state = state.clone();
+        Box::pin(async move {
+            let (Some(outgoing), Ok(thread)) =
+                (outgoing.upgrade(), ThreadId::from_string(&call.thread_id))
+            else {
+                return false;
+            };
+            let subscribers = state.subscribed_connection_ids(thread).await;
+            if subscribers.len() != 1 {
+                return false;
+            }
+            let (id, rx) = outgoing
+                .send_request_to_connections(
+                    Some(&subscribers),
+                    codex_app_server_protocol::ServerRequestPayload::HostImageGenerate(
+                        codex_app_server_protocol::HostImageGenerateParams {
+                            thread_id: call.thread_id,
+                            turn_id: call.turn_id,
+                            call_id: call.call_id,
+                            prompt: call.prompt,
+                            use_current_reference: call.use_current_reference,
+                        },
+                    ),
+                    Some(thread),
+                )
+                .await;
+            match tokio::time::timeout(std::time::Duration::from_secs(240), rx).await {
+                Ok(Ok(Ok(value))) => serde_json::from_value::<
+                    codex_app_server_protocol::HostImageGenerateResponse,
+                >(value)
+                .is_ok_and(|response| response.success),
+                Err(_) => {
+                    outgoing.cancel_request(&id).await;
+                    false
+                }
+                _ => false,
+            }
+        })
+    })
 }
 
