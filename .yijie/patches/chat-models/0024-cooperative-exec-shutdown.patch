@@ -0,0 +1,86 @@
+//! Normal process completion and supported cooperative cancellation only.
+//! No process kill, fault injection, executable substitution or permission edits.
+use crate::spawn_pipe_process;
+use std::collections::HashMap;
+use std::time::Duration;
+
+#[tokio::test]
+async fn cooperative_normal_exit_preserves_output_and_code() {
+    let mut child = spawn_pipe_process(
+        "/bin/sh",
+        &["-c".into(), "printf 'ordinary output\\n'".into()],
+        std::env::temp_dir().as_path(),
+        &HashMap::new(),
+        &None,
+    )
+    .await
+    .expect("normal spawn");
+    child.session.set_cooperative_only();
+    assert_eq!(child.exit_rx.await.expect("normal exit"), 0);
+    let mut output = Vec::new();
+    while let Some(bytes) = child.stdout_rx.recv().await {
+        output.extend(bytes);
+    }
+    while !child.session.has_exited() {
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    assert_eq!(output, b"ordinary output\n");
+    // Already exited: cleanup must not signal a recycled process group.
+    child.session.terminate();
+    assert!(!child.session.stop_requested());
+}
+
+#[tokio::test]
+async fn cooperative_stop_is_idempotent_and_process_exits_normally() {
+    let mut child = spawn_pipe_process(
+        "/bin/sh", &["-c".into(), "trap 'printf stopped; exit 0' INT; printf ready; for i in 1 2 3 4 5; do sleep 0.1; done".into()],
+        std::env::temp_dir().as_path(), &HashMap::new(), &None,
+    ).await.expect("normal spawn");
+    child.session.set_cooperative_only();
+    assert!(
+        child
+            .stdout_rx
+            .recv()
+            .await
+            .expect("ready output")
+            .starts_with(b"ready")
+    );
+    child.session.request_terminate();
+    child.session.request_terminate();
+    assert!(child.session.stop_requested());
+    assert_eq!(child.exit_rx.await.expect("cooperative exit"), 0);
+    let mut tail = Vec::new();
+    while let Some(bytes) = child.stdout_rx.recv().await {
+        tail.extend(bytes);
+    }
+    while !child.session.has_exited() {
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    assert!(tail.ends_with(b"stopped"));
+}
+
+#[tokio::test]
+async fn cooperative_exited_parent_drains_normal_descendant_output() {
+    let mut child = spawn_pipe_process(
+        "/bin/sh",
+        &["-c".into(), "(sleep 0.2; printf tail) & printf head; exit 0".into()],
+        std::env::temp_dir().as_path(),
+        &HashMap::new(),
+        &None,
+    )
+    .await
+    .expect("normal spawn");
+    child.session.set_cooperative_only();
+    assert_eq!(child.exit_rx.await.expect("parent exits normally"), 0);
+    // The process group may still own an output writer; retain it until EOF,
+    // without sending a signal using the already-exited parent's identity.
+    child.session.request_terminate();
+    let mut output = Vec::new();
+    while let Some(bytes) = child.stdout_rx.recv().await {
+        output.extend(bytes);
+    }
+    while !child.session.has_exited() {
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    assert_eq!(output, b"headtail");
+}
