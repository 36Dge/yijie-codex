+// Only the provider request clone is projected. Native V2 history, mailbox,
+// scheduler and turn boundaries continue to use ResponseItem::AgentMessage.
+fn project_native_agent_messages(input: &mut [ResponseItem]) -> Result<()> {
+    for item in input {
+        if let ResponseItem::AgentMessage {
+            author,
+            recipient,
+            content,
+            ..
+        } = item
+        {
+            let text = plaintext_agent_message_content(content).ok_or_else(|| {
+                CodexErr::InvalidRequest("This provider requires plaintext V2 messages; encrypted historical agent messages cannot be replayed by it.".to_string())
+            })?;
+            // Preserve the native identity envelope at ordinary conversation
+            // authority. Agent output never becomes system/developer policy.
+            *item = ResponseItem::Message {
+                id: None,
+                role: "user".to_string(),
+                content: vec![ContentItem::InputText {
+                    text: format!(
+                        "Message Type: MESSAGE\nTask name: {recipient}\nSender: {author}\nPayload:\n{text}"
+                    ),
+                }],
+                phase: None,
+                internal_chat_message_metadata_passthrough: None,
+            };
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod native_message_tests {
+    use super::*;
+    use codex_protocol::AgentPath;
+    use codex_protocol::protocol::InterAgentCommunication;
+
+    #[test]
+    fn native_tools_agent_projection_preserves_native_history_and_identity() {
+        let original = InterAgentCommunication::new(
+            AgentPath::root(),
+            AgentPath::try_from("/root/calculator").unwrap(),
+            vec![],
+            "Calculate 6 * 7".to_string(),
+            true,
+        )
+        .to_model_input_item();
+        let mut request = vec![original.clone()];
+        project_native_agent_messages(&mut request).unwrap();
+        assert!(matches!(original, ResponseItem::AgentMessage { .. }));
+        let ResponseItem::Message { role, content, .. } = &request[0] else {
+            panic!("expected supported message")
+        };
+        assert_eq!(role, "user");
+        let ContentItem::InputText { text } = &content[0] else {
+            panic!("expected native plaintext")
+        };
+        assert!(
+            text.contains("Task name: /root/calculator\nSender: /root\nPayload:\nCalculate 6 * 7")
+        );
+    }
+}
