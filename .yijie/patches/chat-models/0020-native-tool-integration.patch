+//! Function-only transport names for explicitly selected native namespaces.
+//! The original runtime still owns execution, permissions, hooks and cancellation.
+use std::sync::Arc;
+
+use crate::function_tool::FunctionCallError;
+use crate::tools::context::{ToolInvocation, ToolOutput, ToolPayload};
+use crate::tools::registry::{
+    CoreToolRuntime, PostToolUsePayload, PreToolUsePayload, ToolArgumentDiffConsumer,
+    ToolTelemetryTags,
+};
+use codex_tools::{
+    ResponsesApiNamespaceTool, ResponsesApiTool, ToolExecutor, ToolExposure, ToolName, ToolSpec,
+};
+use futures::future::BoxFuture;
+
+pub(super) fn adapt(
+    handler: Arc<dyn CoreToolRuntime>,
+    plaintext_messages: bool,
+) -> Option<Arc<dyn CoreToolRuntime>> {
+    let original = handler.tool_name();
+    let namespace = original.namespace.as_ref()?;
+    let ToolSpec::Namespace(mut spec) = handler.spec() else {
+        return None;
+    };
+    if spec.tools.len() != 1 {
+        return None;
+    }
+    let ResponsesApiNamespaceTool::Function(mut function) = spec.tools.remove(0);
+    let alias = ToolName::plain(format!("{}__{}", namespace, original.name));
+    function.name = alias.name.clone();
+    if plaintext_messages {
+        if let Some(message) = function
+            .parameters
+            .properties
+            .as_mut()
+            .and_then(|p| p.get_mut("message"))
+        {
+            message.encrypted = None;
+        }
+    }
+    Some(Arc::new(FunctionNamespace {
+        handler,
+        original,
+        alias,
+        function,
+    }))
+}
+
+struct FunctionNamespace {
+    handler: Arc<dyn CoreToolRuntime>,
+    original: ToolName,
+    alias: ToolName,
+    function: ResponsesApiTool,
+}
+
+impl FunctionNamespace {
+    fn native_invocation(&self, mut invocation: ToolInvocation) -> ToolInvocation {
+        invocation.tool_name = self.original.clone();
+        invocation
+    }
+}
+
+impl ToolExecutor<ToolInvocation> for FunctionNamespace {
+    fn tool_name(&self) -> ToolName {
+        self.alias.clone()
+    }
+    fn spec(&self) -> ToolSpec {
+        ToolSpec::Function(self.function.clone())
+    }
+    fn exposure(&self) -> ToolExposure {
+        self.handler.exposure()
+    }
+    fn supports_parallel_tool_calls(&self) -> bool {
+        self.handler.supports_parallel_tool_calls()
+    }
+    fn handle(&self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'_> {
+        self.handler.handle(self.native_invocation(invocation))
+    }
+}
+
+impl CoreToolRuntime for FunctionNamespace {
+    fn matches_kind(&self, payload: &ToolPayload) -> bool {
+        self.handler.matches_kind(payload)
+    }
+    fn waits_for_runtime_cancellation(&self) -> bool {
+        self.handler.waits_for_runtime_cancellation()
+    }
+    fn create_diff_consumer(&self) -> Option<Box<dyn ToolArgumentDiffConsumer>> {
+        self.handler.create_diff_consumer()
+    }
+    fn pre_tool_use_payload(&self, invocation: &ToolInvocation) -> Option<PreToolUsePayload> {
+        self.handler
+            .pre_tool_use_payload(&self.native_invocation(invocation.clone()))
+    }
+    fn post_tool_use_payload(
+        &self,
+        invocation: &ToolInvocation,
+        result: &dyn ToolOutput,
+    ) -> Option<PostToolUsePayload> {
+        self.handler
+            .post_tool_use_payload(&self.native_invocation(invocation.clone()), result)
+    }
+    fn with_updated_hook_input(
+        &self,
+        invocation: ToolInvocation,
+        updated_input: serde_json::Value,
+    ) -> Result<ToolInvocation, FunctionCallError> {
+        let mut updated = self
+            .handler
+            .with_updated_hook_input(self.native_invocation(invocation), updated_input)?;
+        updated.tool_name = self.alias.clone();
+        Ok(updated)
+    }
+    fn telemetry_tags<'a>(
+        &'a self,
+        invocation: &'a ToolInvocation,
+    ) -> BoxFuture<'a, ToolTelemetryTags> {
+        Box::pin(async move {
+            let native = self.native_invocation(invocation.clone());
+            self.handler.telemetry_tags(&native).await
+        })
+    }
+}
