+//! Thin input transport for native text tools on function-only model APIs.
+//! Execution, validation, permissions and lifecycle remain with the native tool.
+use crate::function_tool::FunctionCallError;
+use crate::tools::context::ToolPayload;
+use codex_tools::{JsonSchema, ResponsesApiTool, ToolSpec};
+use serde::Deserialize;
+use std::collections::BTreeMap;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Input {
+    input: String,
+}
+
+pub(super) fn wrap(spec: ToolSpec) -> ToolSpec {
+    let ToolSpec::Freeform(tool) = spec else {
+        return spec;
+    };
+    ToolSpec::Function(ResponsesApiTool {
+        name: tool.name,
+        description: format!(
+            "{}\n\nThis deployment accepts a JSON function call with one string field `input`. Put the complete native source or patch in that string. Syntax and code examples above describe the string contents; do not send a custom tool call.",
+            tool.description.replace(
+                "This is a FREEFORM tool, so do not wrap the patch in JSON.",
+                ""
+            )
+        ),
+        strict: false,
+        defer_loading: None,
+        parameters: JsonSchema::object(
+            BTreeMap::from([(
+                "input".to_string(),
+                JsonSchema::string(Some("Complete native source or patch text.".to_string())),
+            )]),
+            Some(vec!["input".to_string()]),
+            Some(false.into()),
+        ),
+        output_schema: None,
+    })
+}
+
+pub(super) fn matches(payload: &ToolPayload, function_input: bool) -> bool {
+    matches!(
+        (payload, function_input),
+        (ToolPayload::Function { .. }, true) | (ToolPayload::Custom { .. }, false)
+    )
+}
+
+pub(super) fn decode(
+    payload: &ToolPayload,
+    function_input: bool,
+) -> Result<String, FunctionCallError> {
+    match (payload, function_input) {
+        (ToolPayload::Custom { input }, false) => Ok(input.clone()),
+        (ToolPayload::Function { arguments }, true) => serde_json::from_str::<Input>(arguments)
+            .map(|value| value.input)
+            .map_err(|_| {
+                FunctionCallError::RespondToModel(
+                    "Expected JSON containing only a string `input` field.".to_string(),
+                )
+            }),
+        _ => Err(FunctionCallError::RespondToModel(
+            "Native text tool input format does not match its declared schema.".to_string(),
+        )),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn native_tools_function_input_preserves_normal_text() {
+        let source = "text(6 * 7);\n";
+        let payload = ToolPayload::Function {
+            arguments: serde_json::json!({"input":source}).to_string(),
+        };
+        assert_eq!(decode(&payload, true).unwrap(), source);
+        assert!(matches(&payload, true));
+        assert!(!matches(&payload, false));
+    }
+
+    #[test]
+    fn native_tools_custom_input_remains_native() {
+        let source = "*** Begin Patch\n*** Add File: note.txt\n+ordinary note\n*** End Patch\n";
+        let payload = ToolPayload::Custom {
+            input: source.to_string(),
+        };
+        assert_eq!(decode(&payload, false).unwrap(), source);
+    }
+
+    #[test]
+    fn native_tools_function_input_reports_normal_shape_error() {
+        let payload = ToolPayload::Function {
+            arguments: serde_json::json!({"input":42}).to_string(),
+        };
+        assert!(decode(&payload, true).is_err());
+    }
+}
