+// Some Responses providers omit arguments in intermediate completed Items while
+// supplying the same complete JSON in deltas and response.completed. Never run
+// that incomplete Item: defer it and subsequent events until identities and the
+// terminal arguments agree. The ordinary nonempty path stays streaming.
+#[derive(Default)]
+struct DeferredFunctionArguments {
+    arguments: std::collections::BTreeMap<(usize, String), (String, Option<String>)>,
+    capture_bytes: usize,
+    capture_lost: bool,
+    queued: Vec<ResponsesStreamEvent>,
+    queued_bytes: usize,
+}
+
+impl DeferredFunctionArguments {
+    const MAX_BYTES: usize = 8 * 1024 * 1024;
+    const MAX_ITEMS: usize = 64;
+    const MAX_EVENTS: usize = 4096;
+
+    fn invalid() -> ApiError {
+        ApiError::Stream("incomplete function arguments could not be verified".into())
+    }
+
+    fn capture(&mut self, event: &ResponsesStreamEvent) {
+        if self.capture_lost {
+            return;
+        }
+        let value = match event.kind.as_str() {
+            "response.function_call_arguments.delta" => event.delta.as_ref(),
+            "response.function_call_arguments.done" => {
+                event.arguments.as_ref().filter(|s| !s.is_empty())
+            }
+            _ => return,
+        };
+        let (Some(index), Some(id), Some(value)) =
+            (event.output_index, event.item_id.as_ref(), value)
+        else {
+            return;
+        };
+        // Losing optional capture does not change ordinary, nonempty Items.
+        // A subsequent empty Item fails closed instead of guessing its input.
+        if id.len() > 1024
+            || self.capture_bytes.saturating_add(value.len()) > Self::MAX_BYTES
+            || (self.arguments.len() >= Self::MAX_ITEMS
+                && !self.arguments.contains_key(&(index, id.clone())))
+        {
+            self.capture_lost = true;
+            self.arguments.clear();
+            return;
+        }
+        self.capture_bytes += value.len();
+        let entry = self.arguments.entry((index, id.clone())).or_default();
+        if event.kind.ends_with(".delta") {
+            entry.0.push_str(value);
+        } else {
+            entry.1 = Some(value.clone());
+        }
+    }
+
+    fn empty_call(event: &ResponsesStreamEvent) -> bool {
+        event.kind == "response.output_item.done"
+            && event.item.as_ref().is_some_and(|item| {
+                item.get("type").and_then(Value::as_str) == Some("function_call")
+                    && item.get("arguments").and_then(Value::as_str) == Some("")
+            })
+    }
+
+    fn accept(
+        &mut self,
+        event: ResponsesStreamEvent,
+        bytes: usize,
+    ) -> Result<Vec<ResponsesStreamEvent>, ApiError> {
+        self.capture(&event);
+        let empty = Self::empty_call(&event);
+        if self.queued.is_empty() && !empty {
+            if event.kind == "response.output_item.done"
+                && let (Some(index), Some(id)) = (
+                    event.output_index,
+                    event
+                        .item
+                        .as_ref()
+                        .and_then(|v| v.get("id"))
+                        .and_then(Value::as_str),
+                )
+                && let Some((delta, done)) = self.arguments.remove(&(index, id.to_owned()))
+            {
+                self.capture_bytes = self
+                    .capture_bytes
+                    .saturating_sub(delta.len() + done.map_or(0, |s| s.len()));
+            }
+            return Ok(vec![event]);
+        }
+        if matches!(
+            event.kind.as_str(),
+            "response.failed" | "response.incomplete"
+        ) {
+            self.queued.clear();
+            return Ok(vec![event]);
+        }
+        if self.capture_lost
+            || self.queued.len() >= Self::MAX_EVENTS
+            || self.queued_bytes.saturating_add(bytes) > Self::MAX_BYTES
+        {
+            return Err(Self::invalid());
+        }
+        self.queued_bytes += bytes;
+        if event.kind != "response.completed" {
+            self.queued.push(event);
+            return Ok(Vec::new());
+        }
+        let response = event.response.as_ref().ok_or_else(Self::invalid)?;
+        if response.get("status").and_then(Value::as_str) != Some("completed")
+            || response.get("error").is_some_and(|v| !v.is_null())
+        {
+            return Err(Self::invalid());
+        }
+        let output = response
+            .get("output")
+            .and_then(Value::as_array)
+            .ok_or_else(Self::invalid)?;
+        let mut recovered = std::collections::BTreeSet::new();
+        for queued in &mut self.queued {
+            if !Self::empty_call(queued) {
+                continue;
+            }
+            let index = queued.output_index.ok_or_else(Self::invalid)?;
+            let item = queued.item.as_mut().ok_or_else(Self::invalid)?;
+            let id = item
+                .get("id")
+                .and_then(Value::as_str)
+                .filter(|s| !s.is_empty())
+                .ok_or_else(Self::invalid)?
+                .to_owned();
+            if !recovered.insert(id.clone()) || recovered.len() > Self::MAX_ITEMS {
+                return Err(Self::invalid());
+            }
+            let terminal = output.get(index).ok_or_else(Self::invalid)?;
+            for field in ["id", "type", "call_id", "name"] {
+                if item
+                    .get(field)
+                    .and_then(Value::as_str)
+                    .filter(|s| !s.is_empty())
+                    .is_none()
+                    || item.get(field) != terminal.get(field)
+                {
+                    return Err(Self::invalid());
+                }
+            }
+            if item.get("namespace") != terminal.get("namespace")
+                || output
+                    .iter()
+                    .filter(|v| v.get("id").and_then(Value::as_str) == Some(id.as_str()))
+                    .count()
+                    != 1
+            {
+                return Err(Self::invalid());
+            }
+            let complete = terminal
+                .get("arguments")
+                .and_then(Value::as_str)
+                .filter(|s| !s.is_empty())
+                .ok_or_else(Self::invalid)?;
+            let (delta, done) = self.arguments.get(&(index, id)).ok_or_else(Self::invalid)?;
+            if delta != complete
+                || done.as_ref().is_some_and(|s| s != complete)
+                || !serde_json::from_str::<Value>(complete).is_ok_and(|value| value.is_object())
+            {
+                return Err(Self::invalid());
+            }
+            item["arguments"] = Value::String(complete.to_owned());
+        }
+        self.queued.push(event);
+        Ok(std::mem::take(&mut self.queued))
     }
 }
 
