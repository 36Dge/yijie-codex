+    fn feat156_function(id: &str, arguments: &str) -> Value {
+        json!({"type":"function_call","id":id,"call_id":format!("call_{id}"),"name":"exec_command","arguments":arguments})
+    }
+
+    #[tokio::test]
+    async fn feat156_terminal_arguments_restore_empty_item_and_preserve_following_order() {
+        let a = r#"{"cmd":"/bin/pwd"}"#;
+        let b = r#"{"cmd":"/usr/bin/true"}"#;
+        let events = run_sse(vec![
+            json!({"type":"response.function_call_arguments.delta","output_index":0,"item_id":"first","delta":&a[..8]}),
+            json!({"type":"response.function_call_arguments.delta","output_index":1,"item_id":"second","delta":b}),
+            json!({"type":"response.function_call_arguments.delta","output_index":0,"item_id":"first","delta":&a[8..]}),
+            json!({"type":"response.function_call_arguments.done","output_index":0,"item_id":"first","arguments":""}),
+            json!({"type":"response.output_item.done","output_index":0,"item":feat156_function("first","")}),
+            json!({"type":"response.output_text.delta","delta":"ordinary following text"}),
+            json!({"type":"response.output_item.done","output_index":1,"item":feat156_function("second",b)}),
+            json!({"type":"response.completed","response":{"id":"resp1","status":"completed","output":[feat156_function("first",a),feat156_function("second",b)]}}),
+        ]).await;
+        assert_matches!(&events[0], ResponseEvent::OutputItemDone(ResponseItem::FunctionCall { arguments, call_id, .. }) if arguments == a && call_id == "call_first");
+        assert_matches!(&events[1], ResponseEvent::OutputTextDelta(text) if text == "ordinary following text");
+        assert_matches!(&events[2], ResponseEvent::OutputItemDone(ResponseItem::FunctionCall { arguments, call_id, .. }) if arguments == b && call_id == "call_second");
+        assert_matches!(&events[3], ResponseEvent::Completed { .. });
+        assert_eq!(events.len(), 4);
+    }
+
+    #[tokio::test]
+    async fn feat156_nonempty_item_keeps_original_streaming_path() {
+        let item = json!({"type":"response.output_item.done","output_index":0,"item":feat156_function("ordinary",r#"{"cmd":"/bin/pwd"}"#)});
+        let mut deferred = DeferredFunctionArguments::default();
+        let events = deferred
+            .accept(serde_json::from_value(item).unwrap(), 200)
+            .unwrap();
+        assert_eq!(events.len(), 1);
+        assert!(deferred.queued.is_empty());
+        assert_matches!(
+            process_responses_event(events.into_iter().next().unwrap()).unwrap(),
+            Some(ResponseEvent::OutputItemDone(_))
+        );
+    }
+
+    #[tokio::test]
+    async fn feat156_incomplete_stream_does_not_dispatch_empty_function() {
+        let event = json!({"type":"response.output_item.done","output_index":0,"item":feat156_function("ordinary","")});
+        let body = format!("data: {event}\n\n");
+        let events = collect_events(&[body.as_bytes()]).await;
+        assert_eq!(events.len(), 1);
+        assert_matches!(&events[0], Err(ApiError::Stream(_)));
+    }
+
+    #[test]
+    fn feat156_terminal_recovery_requires_matching_identity_and_arguments() {
+        let arguments = r#"{"cmd":"/bin/pwd"}"#;
+        for case in [
+            "missing output",
+            "different call",
+            "different argument",
+            "different position",
+            "non-object",
+        ] {
+            let mut deferred = DeferredFunctionArguments::default();
+            let delta = json!({"type":"response.function_call_arguments.delta","output_index":0,"item_id":"ordinary","delta":arguments});
+            deferred
+                .accept(serde_json::from_value(delta).unwrap(), 150)
+                .unwrap();
+            let item = json!({"type":"response.output_item.done","output_index":0,"item":feat156_function("ordinary","")});
+            assert!(
+                deferred
+                    .accept(serde_json::from_value(item).unwrap(), 150)
+                    .unwrap()
+                    .is_empty()
+            );
+            let mut terminal = feat156_function("ordinary", arguments);
+            match case {
+                "different call" => terminal["call_id"] = json!("other_call"),
+                "different argument" => terminal["arguments"] = json!(r#"{"cmd":"/usr/bin/true"}"#),
+                "non-object" => terminal["arguments"] = json!("[]"),
+                _ => {}
+            }
+            let output = match case {
+                "missing output" => vec![],
+                "different position" => {
+                    vec![json!({"type":"reasoning","id":"reasoning"}), terminal]
+                }
+                _ => vec![terminal],
+            };
+            let completed = json!({"type":"response.completed","response":{"id":"resp1","status":"completed","output":output}});
+            assert!(
+                deferred
+                    .accept(serde_json::from_value(completed).unwrap(), 300)
+                    .is_err(),
+                "{case}"
+            );
+        }
+    }
