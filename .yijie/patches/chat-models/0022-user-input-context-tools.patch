+    interaction_tools_compaction_policy_case("explicit").await
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn interaction_tools_automatic_compaction_keeps_summary_path() -> Result<()> {
+    interaction_tools_compaction_policy_case("automatic").await
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn interaction_tools_manual_compaction_keeps_summary_path() -> Result<()> {
+    interaction_tools_compaction_policy_case("manual").await
+}
