+// Both routes use the upstream implementations. The local profile changes only
+// which route ordinary compaction selects; explicit new_context still resets.
+async fn interaction_tools_compaction_policy_case(mode: &str) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let first = match mode {
+        "explicit" => sse(vec![
+            ev_response_created("policy-1"),
+            ev_function_call("window", "new_context", "{}"),
+            ev_completed("policy-1"),
+        ]),
+        "automatic" => sse(vec![
+            ev_response_created("policy-1"),
+            ev_function_call("remaining", "get_context_remaining", "{}"),
+            ev_completed_with_tokens("policy-1", 9_500),
+        ]),
+        _ => sse(vec![
+            ev_response_created("policy-1"),
+            ev_assistant_message("before", "ordinary response"),
+            ev_completed("policy-1"),
+        ]),
+    };
+    let mut sequence = vec![first];
+    if mode != "explicit" {
+        sequence.push(sse(vec![
+            ev_response_created("policy-summary"),
+            ev_assistant_message("summary", "SYNTHETIC_NATIVE_POLICY_SUMMARY"),
+            ev_completed("policy-summary"),
+        ]));
+    }
+    sequence.push(sse(vec![
+        ev_response_created("policy-2"),
+        ev_assistant_message("after", "done"),
+        ev_completed("policy-2"),
+    ]));
+    let responses = mount_sse_sequence(&server, sequence).await;
+    let mut provider = built_in_model_providers(None)["openai"].clone();
+    provider.name = "YiJie ordinary policy test".into();
+    provider.base_url = Some(format!("{}/v1", server.uri()));
+    provider.supports_websockets = false;
+    let automatic = mode == "automatic";
+    let test = test_codex()
+        .with_config(move |config| {
+            config.model_provider = provider;
+            config.model_context_window = Some(if automatic {
+                10_000
+            } else {
+                CONFIGURED_CONTEXT_WINDOW
+            });
+            config.features.enable(Feature::TokenBudget).unwrap();
+            config.token_budget = Some(TokenBudgetConfig {
+                reset_on_compact: false,
+                ..TokenBudgetConfig::default()
+            });
+        })
+        .build(&server)
+        .await?;
+    test.submit_turn("ordinary policy task").await?;
+    if mode == "manual" {
+        test.codex.submit(Op::Compact).await?;
+        assert_context_compaction_item_lifecycle(&test.codex).await;
+        test.submit_turn("continue after manual compact").await?;
+    }
+    let requests = responses.requests();
+    assert_eq!(requests.len(), if mode == "explicit" { 2 } else { 3 });
+    if mode != "explicit" {
+        assert!(requests[2].body_contains_text("SYNTHETIC_NATIVE_POLICY_SUMMARY"));
+    }
+    if mode == "explicit" {
+        assert!(!requests[1].body_contains_text("ordinary policy task"));
+        let thread = test.session_configured.thread_id;
+        let before = token_budget_contexts(&requests[0]);
+        let after = token_budget_contexts(&requests[1]);
+        assert_eq!(before.len(), 1);
+        assert_eq!(after.len(), 1);
+        assert_ne!(
+            token_budget_window_ids(&before[0], thread).2,
+            token_budget_window_ids(&after[0], thread).2
+        );
+    }
+    Ok(())
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
