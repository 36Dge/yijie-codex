diff --git a/core/src/tools/search_progress.rs b/core/src/tools/search_progress.rs
new file mode 100644
index 0000000..e08fd94
--- /dev/null
+++ b/core/src/tools/search_progress.rs
@@ -0,0 +1,258 @@
+//! Only completed native deep-search receipts can drive this turn's correction.
+//! Compare the material actually exposed at the outer tool boundary. A script
+//! that extracts fresh chunks or produces another deliverable stays ordinary.
+use std::collections::HashMap;
+use std::sync::Mutex;
+use std::sync::PoisonError;
+
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use codex_protocol::models::{
+    FunctionCallOutputBody, FunctionCallOutputContentItem, ResponseInputItem,
+};
+use serde_json::Value;
+
+#[derive(Debug, Default)]
+pub(crate) struct Step {
+    expected: usize,
+    previews: Vec<(String, bool, Value)>,
+    printed: Vec<Value>,
+    other: bool,
+}
+#[derive(Default)]
+pub(crate) struct History {
+    delivered: HashMap<String, Value>,
+    correction_sent: bool,
+}
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Next {
+    Ordinary,
+    Correct,
+    Finish,
+}
+
+impl Step {
+    pub(crate) fn begin(&mut self, deep: bool) {
+        if deep {
+            self.expected += 1;
+        } else {
+            self.other = true;
+        }
+    }
+
+    pub(crate) fn receive(&mut self, meta: Option<&Value>, preview: Option<&Value>) {
+        let Some(fact) = meta.and_then(|v| v.get("ai.yijie/deep-search-receipt")) else {
+            return;
+        };
+        let Some(view) = preview else { return };
+        let Some(id) = fact["operation_id"]
+            .as_str()
+            .filter(|v| uuid::Uuid::parse_str(v).is_ok())
+        else {
+            return;
+        };
+        if self.previews.len() >= 64
+            || fact["version"] != 2
+            || fact["availability"] != "available"
+            || fact["dispatch"] != "responded"
+            || (fact["outcome"] == "empty" && view["status"] != "no_matches")
+            || !matches!(
+                fact["outcome"].as_str(),
+                Some("empty" | "results" | "partial")
+            )
+        {
+            return;
+        }
+        let repeated = matches!(fact["relation"].as_str(), Some("joined" | "reused"));
+        self.previews.push((id.to_owned(), repeated, view.clone()));
+    }
+
+    pub(crate) fn output(&mut self, response: ResponseInputItem) {
+        if self.other || self.previews.is_empty() {
+            self.other = true;
+            return;
+        }
+        let payload = match response {
+            ResponseInputItem::FunctionCallOutput { output, .. }
+            | ResponseInputItem::CustomToolCallOutput { output, .. } => output,
+            _ => {
+                self.other = true;
+                return;
+            }
+        };
+        if let FunctionCallOutputBody::ContentItems(items) = &payload.body
+            && items
+                .iter()
+                .any(|item| !matches!(item, FunctionCallOutputContentItem::InputText { .. }))
+        {
+            self.other = true;
+            return;
+        }
+        let Some(text) = payload.body.to_text() else {
+            self.other = true;
+            return;
+        };
+        let Some((header, body)) = text.split_once("Output:") else {
+            self.other = true;
+            return;
+        };
+        let header = header.trim();
+        if !(header.starts_with("Wall time:") || header.starts_with("Script completed\nWall time "))
+            || body.len() > 65536
+        {
+            self.other = true;
+            return;
+        }
+        for line in body.lines().map(str::trim).filter(|v| !v.is_empty()) {
+            let Ok(value) = serde_json::from_str::<Value>(line) else {
+                self.other = true;
+                return;
+            };
+            if !self.collect(&value) {
+                self.other = true;
+                return;
+            }
+        }
+    }
+    fn collect(&mut self, value: &Value) -> bool {
+        if self.printed.len() >= 64 {
+            return false;
+        }
+        if self.previews.iter().any(|(_, _, p)| p == value) {
+            self.printed.push(value.clone());
+            return true;
+        }
+        if let Some(rows) = value.as_array() {
+            if rows.is_empty()
+                && self.previews.len() == 1
+                && self.previews[0].2["status"] == "no_matches"
+            {
+                self.printed.push(self.previews[0].2.clone());
+                return true;
+            }
+            return !rows.is_empty() && rows.iter().all(|v| self.collect(v));
+        }
+        if let Some(o) = value.as_object()
+            && o.len() == 2
+            && o.get("i").is_some_and(Value::is_u64)
+            && let Some(r) = o.get("r")
+        {
+            return self.collect(r);
+        }
+        false
+    }
+    fn advance(&self, history: &mut History) -> Next {
+        if self.other
+            || self.previews.is_empty()
+            || self.expected != self.previews.len()
+            || self.printed.len() != self.previews.len()
+        {
+            return Next::Ordinary;
+        }
+        let mut remaining = self.printed.clone();
+        for (_, _, v) in &self.previews {
+            let Some(i) = remaining.iter().position(|p| p == v) else {
+                return Next::Ordinary;
+            };
+            remaining.swap_remove(i);
+        }
+        let mut only_repeats = true;
+        for (id, repeated, view) in &self.previews {
+            // The same operation can expose a different material projection.
+            // Compare the selected sources and their versioned content too.
+            let mut material = view.clone();
+            if let Some(object) = material.as_object_mut() {
+                object.remove("reused");
+            }
+            only_repeats &= *repeated && history.delivered.get(id) == Some(&material);
+            if history.delivered.len() < 1024 || history.delivered.contains_key(id) {
+                history.delivered.insert(id.clone(), material);
+            }
+        }
+        if !only_repeats {
+            return Next::Ordinary;
+        }
+        if history.correction_sent {
+            return Next::Finish;
+        }
+        history.correction_sent = true;
+        Next::Correct
+    }
+}
+pub(crate) fn advance(step: &Mutex<Step>, turn: &TurnContext) -> Next {
+    let history = turn
+        .extension_data
+        .get_or_init(|| Mutex::new(History::default()));
+    step.lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .advance(&mut history.lock().unwrap_or_else(PoisonError::into_inner))
+}
+/// Before withdrawing turn tools, honor independent work already in flight.
+pub(crate) async fn work_is_settled(session: &Session) -> bool {
+    if session.services.code_mode_service.has_open_cells()
+        || !session
+            .services
+            .unified_exec_manager
+            .list_processes()
+            .await
+            .is_empty()
+    {
+        return false;
+    }
+    let agents = &session.services.agent_control;
+    let Ok(children) = agents
+        .list_live_agent_subtree_thread_ids(session.thread_id)
+        .await
+    else {
+        return false;
+    };
+    for child in children {
+        if child != session.thread_id
+            && matches!(
+                agents.get_status(child).await,
+                codex_protocol::protocol::AgentStatus::PendingInit
+                    | codex_protocol::protocol::AgentStatus::Running
+            )
+        {
+            return false;
+        }
+    }
+    true
+}
+pub(crate) fn reset(turn: &TurnContext) {
+    let history = turn
+        .extension_data
+        .get_or_init(|| Mutex::new(History::default()));
+    *history.lock().unwrap_or_else(PoisonError::into_inner) = History::default();
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    fn search(id: &str, repeated: bool) -> Step {
+        let p = json!({"query":id,"results":[],"reused":repeated});
+        Step {
+            expected: 1,
+            previews: vec![(id.into(), repeated, p.clone())],
+            printed: vec![p],
+            other: false,
+        }
+    }
+    #[test]
+    fn bounded_search_correction_keeps_changed_work_and_material_reads() {
+        let mut h = History::default();
+        assert_eq!(search("temple", false).advance(&mut h), Next::Ordinary);
+        assert_eq!(search("temple", true).advance(&mut h), Next::Correct);
+        let mut mixed = search("weather", false);
+        let old = search("temple", true);
+        mixed.expected += 1;
+        mixed.previews.extend(old.previews);
+        mixed.printed.extend(old.printed);
+        assert_eq!(mixed.advance(&mut h), Next::Ordinary);
+        let mut chunk = search("weather", true);
+        chunk.printed = vec![json!({"body":"new source"})];
+        assert_eq!(chunk.advance(&mut h), Next::Ordinary);
+        assert_eq!(search("temple", true).advance(&mut h), Next::Finish);
+    }
+}
