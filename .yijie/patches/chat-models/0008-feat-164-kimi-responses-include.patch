+#[test]
+fn feat164_include_matches_kimi_documented_enum_without_changing_other_models() {
+    let kimi = feat164_request("kimi-k3.1-pro", false).expect("Kimi request");
+    assert!(kimi.include.is_empty());
+    assert_eq!(
+        kimi.reasoning.expect("reasoning").effort,
+        Some(ReasoningEffort::Max)
+    );
+    let minimax = feat164_request("MiniMax-M3", false).expect("MiniMax request");
+    assert_eq!(minimax.include, ["reasoning.encrypted_content"]);
