+        }))
+        .unwrap()
+    }
+
+    #[test]
+    fn answer_completion_repeated_successful_plans_enter_existing_finalization() {
+        let mut state = State::default();
+        for explanation in ["first", "different explanation"] {
+            state.record_plan(&plan("in_progress", explanation));
+            assert_eq!(state.decide(None, true), Decision::Accept);
+        }
+        state.record_plan(&plan("in_progress", "third explanation"));
+        assert_eq!(state.decide(None, true), Decision::Continue);
+        assert!(state.finalizing);
+        // Reuse the existing bounded recovery count, including ignored tools.
+        assert_eq!(state.decide(None, true), Decision::Continue);
+        assert_eq!(state.decide(None, true), Decision::Failed);
+    }
+
+    #[test]
