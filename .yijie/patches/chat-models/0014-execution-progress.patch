 impl State {
+    fn record_plan(&mut self, args: &UpdatePlanArgs) {
+        let Ok(plan) = serde_json::to_string(&args.plan) else {
+            return;
+        };
+        self.unchanged_plan_updates = if self.last_plan.as_ref() == Some(&plan) {
+            (self.unchanged_plan_updates + 1).min(MAX_UNCHANGED_PLAN_UPDATES)
+        } else {
+            1
+        };
+        self.last_plan = Some(plan);
+    }
+
+    fn clear_plan_progress(&mut self) {
+        if !self.finalizing {
+            self.last_plan = None;
+            self.unchanged_plan_updates = 0;
+        }
+    }
