+#[derive(Default)]
+struct PendingSearchTitles {
+    rows: Vec<codex_protocol::items::WebSearchSourceTitle>,
+    bytes: usize,
+}
+
+pub(crate) async fn queue_search_titles(
+    turn: &TurnContext,
+    rows: Vec<codex_protocol::items::WebSearchSourceTitle>,
+) {
+    let cell = turn.extension_data.get_or_init(|| Mutex::new(PendingSearchTitles::default()));
+    let mut pending = cell.lock().await;
+    // Bound optional display data by wire size. A long ordinary research response
+    // can have hundreds of short source rows spread over distinct searches.
+    for row in rows {
+        let Ok(bytes) = serde_json::to_vec(&row) else { continue };
+        let size = bytes.len() + 1;
+        if pending.rows.len() >= 4096 || pending.bytes.saturating_add(size) > 4 * 1024 * 1024 {
+            break;
+        }
+        pending.bytes += size;
+        pending.rows.push(row);
+    }
+}
+
+pub(crate) async fn attach_search_titles(turn: &TurnContext, event: &mut EventMsg) {
+    let target = match event {
+        EventMsg::ItemCompleted(done) => match &mut done.item {
+            TurnItem::AgentMessage(message) => message.publication.as_mut().map(|p| &mut p.web_search_source_titles),
+            _ => None,
+        },
+        EventMsg::TurnComplete(done) => Some(&mut done.web_search_source_titles),
+        _ => None,
+    };
+    if let Some(target) = target {
+        let cell = turn.extension_data.get_or_init(|| Mutex::new(PendingSearchTitles::default()));
+        let mut pending = cell.lock().await;
+        if !pending.rows.is_empty() {
+            *target = Some(std::mem::take(&mut *pending).rows);
+        }
+    }
+}
+
