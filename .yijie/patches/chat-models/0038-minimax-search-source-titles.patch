diff --git a/codex-api/src/sse/responses/search_titles.rs b/codex-api/src/sse/responses/search_titles.rs
new file mode 100644
--- /dev/null
+++ b/codex-api/src/sse/responses/search_titles.rs
@@ -0,0 +1,220 @@
+//! Match titles to a provider-confirmed search membership inside one Responses stream.
+use super::ResponsesStreamEvent;
+use codex_protocol::items::WebSearchSourceTitle;
+use serde_json::Value;
+use std::collections::BTreeMap;
+
+#[derive(Default)]
+pub(super) struct ResponseTitles {
+    minimax: bool,
+    calls: BTreeMap<String, Vec<String>>,
+    source_count: usize,
+    citations: BTreeMap<String, Option<String>>,
+}
+
+const MAX_SOURCE_PAIRS: usize = 4096;
+const MAX_SOURCES: usize = 32;
+
+impl ResponseTitles {
+    pub(super) fn observe(
+        &mut self,
+        event: &ResponsesStreamEvent,
+    ) -> Option<Vec<WebSearchSourceTitle>> {
+        let response = event.response.as_ref();
+        if let Some(model) = response
+            .and_then(|v| v.get("model"))
+            .and_then(Value::as_str)
+        {
+            self.minimax = model == "MiniMax-M3";
+        }
+        if !self.minimax {
+            return None;
+        }
+        match event.kind.as_str() {
+            "response.output_item.done" => {
+                if let Some(item) = &event.item {
+                    self.capture(item);
+                }
+            }
+            "response.completed" => {
+                if let Some(items) = response
+                    .and_then(|r| r.get("output"))
+                    .and_then(Value::as_array)
+                {
+                    for item in items {
+                        self.capture(item);
+                    }
+                }
+                let mut updates = Vec::new();
+                for (id, urls) in &self.calls {
+                    for url in urls {
+                        if let Some(Some(title)) = self.citations.get(url) {
+                            updates.push(WebSearchSourceTitle {
+                                search_item_id: id.clone(),
+                                url: url.clone(),
+                                title: title.clone(),
+                            });
+                        }
+                    }
+                }
+                if !updates.is_empty() {
+                    return Some(updates);
+                }
+            }
+            _ => {}
+        }
+        None
+    }
+
+    fn capture(&mut self, item: &Value) {
+        match item.get("type").and_then(Value::as_str) {
+            Some("web_search_call")
+                if item.pointer("/action/type").and_then(Value::as_str) == Some("search") =>
+            {
+                let Some(id) = item
+                    .get("id")
+                    .and_then(Value::as_str)
+                    .filter(|s| !s.is_empty() && s.len() <= 512)
+                else {
+                    return;
+                };
+                let Some(rows) = item.pointer("/action/sources").and_then(Value::as_array) else {
+                    return;
+                };
+                let previous = self.calls.get(id).map_or(0, Vec::len);
+                let capacity = MAX_SOURCE_PAIRS.saturating_sub(self.source_count - previous);
+                let mut urls = Vec::new();
+                for row in rows.iter().take(MAX_SOURCES) {
+                    if urls.len() == capacity {
+                        break;
+                    }
+                    if row.get("type").and_then(Value::as_str) == Some("url")
+                        && row
+                            .get("title")
+                            .and_then(Value::as_str)
+                            .is_none_or(|s| s.trim().is_empty())
+                        && let Some(url) = row
+                            .get("url")
+                            .and_then(Value::as_str)
+                            .filter(|s| !s.is_empty() && s.len() <= 2048)
+                        && !urls.iter().any(|old| old == url)
+                    {
+                        urls.push(url.to_owned());
+                    }
+                }
+                self.source_count = self.source_count - previous + urls.len();
+                if urls.is_empty() {
+                    self.calls.remove(id);
+                } else {
+                    self.calls.insert(id.to_owned(), urls);
+                }
+            }
+            Some("message") if item.get("role").and_then(Value::as_str) == Some("assistant") => {
+                let Some(parts) = item.get("content").and_then(Value::as_array) else {
+                    return;
+                };
+                for part in parts {
+                    if part.get("type").and_then(Value::as_str) != Some("output_text") {
+                        continue;
+                    }
+                    let Some(rows) = part.get("annotations").and_then(Value::as_array) else {
+                        continue;
+                    };
+                    for row in rows {
+                        if row.get("type").and_then(Value::as_str) != Some("url_citation") {
+                            continue;
+                        }
+                        let Some(url) = row
+                            .get("url")
+                            .and_then(Value::as_str)
+                            .filter(|s| !s.is_empty() && s.len() <= 2048)
+                        else {
+                            continue;
+                        };
+                        let Some(title) = row
+                            .get("title")
+                            .and_then(Value::as_str)
+                            .map(str::trim)
+                            .filter(|s| !s.is_empty() && s.len() <= 2048)
+                        else {
+                            continue;
+                        };
+                        if let Some(old) = self.citations.get_mut(url) {
+                            if old.as_deref() != Some(title) {
+                                *old = None;
+                            }
+                        } else if self.citations.len() < MAX_SOURCE_PAIRS {
+                            self.citations
+                                .insert(url.to_owned(), Some(title.to_owned()));
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn search(id: &str, urls: &[&str]) -> Value {
+        json!({"type":"web_search_call","id":id,"action":{"type":"search","sources":urls.iter().map(|url| json!({"type":"url","url":url})).collect::<Vec<_>>()}})
+    }
+
+    #[test]
+    fn titles_require_exact_membership_and_agreement_within_a_response() {
+        let mut state = ResponseTitles::default();
+        let shared = "https://example.org/both";
+        let first = "https://example.org/first";
+        let last = "https://example.org/last";
+        let untouched = "https://example.org/other";
+        let cite = |url: &str, title: &str| json!({"type":"url_citation","url":url,"title":title});
+        let msg = json!({"type":"message","role":"assistant","content":[{"type":"output_text","annotations":[cite(shared,"Both"),cite(first,"First"),cite(last,"Title A"),cite(last,"Title B"),cite(untouched,"Other")]}]});
+        let event=serde_json::from_value(json!({"type":"response.completed","response":{"model":"MiniMax-M3","output":[search("s1",&[first,shared]),search("s2",&[shared,last]),msg]}})).unwrap();
+        let rows = state.observe(&event).unwrap();
+        assert_eq!(
+            rows.iter()
+                .map(|r| (r.search_item_id.as_str(), r.url.as_str(), r.title.as_str()))
+                .collect::<Vec<_>>(),
+            vec![
+                ("s1", first, "First"),
+                ("s1", shared, "Both"),
+                ("s2", shared, "Both")
+            ]
+        );
+    }
+    #[test]
+    fn all_fourteen_searches_keep_their_ten_titles() {
+        let mut output = Vec::new();
+        let mut notes = Vec::new();
+        for call in 0..14 {
+            let urls: Vec<_> = (0..10)
+                .map(|source| format!("https://example.org/city/{call}/{source}"))
+                .collect();
+            let borrowed: Vec<_> = urls.iter().map(String::as_str).collect();
+            output.push(search(&format!("search-{call}"), &borrowed));
+            notes.extend(
+                urls.into_iter()
+                    .map(|url| json!({"type":"url_citation","url":url,"title":"城市资料"})),
+            );
+        }
+        output.push(json!({"type":"message","role":"assistant","content":[{"type":"output_text","annotations":notes}]}));
+        let event = serde_json::from_value(
+            json!({"type":"response.completed","response":{"model":"MiniMax-M3","output":output}}),
+        )
+        .unwrap();
+        let rows = ResponseTitles::default().observe(&event).unwrap();
+        assert_eq!(rows.len(), 140);
+        for call in 0..14 {
+            assert_eq!(
+                rows.iter()
+                    .filter(|row| row.search_item_id == format!("search-{call}"))
+                    .count(),
+                10
+            );
+        }
+    }
+}
