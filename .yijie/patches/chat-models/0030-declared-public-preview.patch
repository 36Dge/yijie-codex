+
+/// The client must opt into both immutable publication and live previews.
+pub(crate) fn preview_enabled(turn: &TurnContext) -> bool {
+    turn.developer_instructions.as_deref().is_some_and(|text|
+        text.lines().any(|line| line == "[yijie-public-preview-v1]"))
+}
+
+/// Preview only the same bounded, parsed body that the publication gate is
+/// holding. A provider phase or an assigned step is already streaming normally.
+pub(crate) async fn send_preview(sess: &Session, turn: &TurnContext, id: &str, delta: &str) {
+    if delta.is_empty() { return; }
+    let cell = state(turn);
+    let state = cell.lock().await;
+    let Some(candidate) = state.pending.iter().find(|candidate|
+        candidate.item.id == id && candidate.published.is_none()) else { return; };
+    let offset = candidate.preview.len();
+    let visible = take_prefix(delta, MAX_ITEM_BYTES.saturating_sub(offset)
+        .min(MAX_PENDING_BYTES.saturating_sub(state.bytes())));
+    if !visible.is_empty() {
+        sess.send_event_direct(turn, EventMsg::AgentMessageContentDelta(AgentMessageContentDeltaEvent {
+            thread_id: sess.thread_id.to_string(), turn_id: turn.sub_id.clone(),
+            item_id: id.to_owned(), delta: visible.to_owned(), preview_offset: Some(offset as u32),
+        })).await;
+    }
+}
