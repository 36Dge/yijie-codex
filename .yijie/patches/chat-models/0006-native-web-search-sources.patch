+        assert_eq!(
+            serde_json::to_value(web_search_action_from_core(core)).unwrap(),
+            source
+        );
+        let old = serde_json::json!({"type":"search","query":"city statistics","queries":null});
+        let core = serde_json::from_value(old.clone()).unwrap();
+        assert_eq!(
+            serde_json::to_value(web_search_action_from_core(core)).unwrap(),
+            old
+        );
+    }
+}
