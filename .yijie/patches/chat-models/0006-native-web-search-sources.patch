+    #[test]
+    fn source_web_sources_survive_existing_action_projection() {
+        let source = serde_json::json!({"type":"search","query":"city statistics","queries":null,"sources":[{"type":"url","url":"https://example.org/statistics/2025","title":"Annual statistics"}]});
