 impl ApprovalStore {
+    pub(crate) fn inherit_session_approvals(&mut self, previous: &Self, accepts: impl Fn(&str) -> bool) {
+        for (key, decision) in &previous.map {
+            if matches!(decision, ReviewDecision::ApprovedForSession) && accepts(key) {
+                self.map.insert(key.clone(), decision.clone());
+            }
+        }
+    }
