+pub(crate) fn is_market_approval_key(serialized: &str) -> bool {
+    let Ok(key) = serde_json::from_str::<McpToolApprovalKey>(serialized) else {
+        return false;
+    };
+    key.server == "yijie_market" && key.connector_id.as_deref()
+        .and_then(|id| id.strip_prefix("yijie-market-"))
+        .is_some_and(|scope| scope.len() == 64 && scope.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)))
+}
+
+fn market_approval_key(scope: &str, tool: &str) -> McpToolApprovalKey {
+    McpToolApprovalKey { server: "yijie_market".to_owned(),
+        connector_id: Some(format!("yijie-market-{scope}")), tool_name: tool.to_owned() }
+}
+
+pub(crate) fn market_persist_options(turn: &TurnContext, scope: Option<&str>, tool: &str) -> Vec<&'static str> {
+    let key = scope.map(|s| market_approval_key(s, tool));
+    let options = mcp_tool_approval_prompt_options(key.as_ref(), key.as_ref(),
+        turn.config.features.enabled(Feature::ToolCallMcpElicitation));
+    let mut result = Vec::new();
+    if options.allow_session_remember { result.push(MCP_TOOL_APPROVAL_PERSIST_SESSION); }
+    if options.allow_persistent_approval { result.push(MCP_TOOL_APPROVAL_PERSIST_ALWAYS); }
+    result
+}
+
+pub(crate) async fn market_remembered(sess: &Session, scope: &str, tool: &str) -> Option<&'static str> {
+    let key = market_approval_key(scope, tool);
+    // Config edits made in another thread (including withdrawal) apply here.
+    sess.reload_user_config_layer().await;
+    let config = sess.get_config().await;
+    let user = config.config_layer_stack.effective_user_config();
+    let setting = user.as_ref().and_then(|v| v.get("apps"))
+        .and_then(|v| v.get(key.connector_id.as_deref()?))
+        .and_then(|v| v.get("tools")).and_then(|v| v.get(tool))
+        .and_then(|v| v.get("approval_mode")).and_then(|v| v.as_str());
+    if setting == Some("approve") { return Some("native_always"); }
+    mcp_tool_approval_is_remembered(sess, &key).await.then_some("native_session")
+}
+
+pub(crate) async fn remember_market_choice(sess: &Session, turn: &TurnContext, scope: &str, tool: &str,
+    response: ElicitationResponse) -> &'static str {
+    let key = market_approval_key(scope, tool);
+    match parse_mcp_tool_approval_elicitation_response(Some(response), "") {
+        McpToolApprovalDecision::AcceptAndRemember => {
+            if let Some(app) = &key.connector_id && persist_codex_app_tool_approval(&turn.config, app, tool).await.is_ok()
+                && market_remembered(sess, scope, tool).await == Some("native_always") {
+                return "stored_always";
+            }
+            remember_mcp_tool_approval(sess, key).await;
+            "stored_session"
+        }
+        McpToolApprovalDecision::AcceptForSession => {
+            remember_mcp_tool_approval(sess, key).await;
+            "stored_session"
+        }
+        _ => "not_stored",
+    }
+}
