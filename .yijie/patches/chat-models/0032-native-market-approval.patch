+    /// An idle, unsubscribed thread may be re-created solely to change its per-turn
+    /// MCP configuration. Keep its scoped market decisions in the native store.
+    pub async fn inherit_market_session_approvals(&self, previous: &Self) {
+        if self.codex.session.thread_id() != previous.codex.session.thread_id()
+            || std::ptr::eq(self, previous)
+        {
+            return;
+        }
+        let previous = previous.codex.session.services.tool_approvals.lock().await;
+        self.codex.session.services.tool_approvals.lock().await
+            .inherit_session_approvals(&previous, crate::mcp_tool_call::is_market_approval_key);
+    }
