diff --git a/core/src/session/market_approval.rs b/core/src/session/market_approval.rs
new file mode 100644
--- /dev/null
+++ b/core/src/session/market_approval.rs
@@ -0,0 +1,191 @@
+//! Bind the registered market call to Codex's existing MCP reviewer and storage.
+//! The Host reads the frozen review over its private Worker pipe. Every accept,
+//! including a memory hit, needs a second, call-specific owner acknowledgement.
+use super::*;
+use codex_mcp::{McpPermissionPromptAutoApproveContext, mcp_permission_prompt_is_auto_approved};
+use codex_protocol::approvals::ElicitationRequest;
+use serde::Deserialize;
+use serde_json::{Value as Json, json};
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Review {
+    tool: String,
+    title: String,
+    arguments: Json,
+    scope: Option<String>,
+    remaining_ms: u64,
+}
+
+fn decline() -> ElicitationResponse {
+    ElicitationResponse {
+        action: ElicitationAction::Decline,
+        content: None,
+        meta: None,
+    }
+}
+
+async fn owner(
+    session: &Session,
+    turn: &TurnContext,
+    reference: &str,
+    phase: &str,
+    scope: Option<&str>,
+    persist: &[&str],
+) -> ElicitationResponse {
+    let mut meta = json!({"yijieKind":"gateway_native_approval_v1",
+        "yijieMarketCallRef":reference,"yijieNativePhase":phase});
+    if let Some(scope) = scope {
+        meta["yijieScope"] = json!(scope);
+    }
+    if !persist.is_empty() {
+        meta["persist"] = json!(persist);
+    }
+    let result = session
+        .request_mcp_server_elicitation(
+            turn,
+            "yijie_market".to_owned(),
+            rmcp::model::NumberOrString::String(format!("market-{reference}-{phase}").into()),
+            ElicitationRequest::Form {
+                meta: Some(meta),
+                message: "连接器调用".to_owned(),
+                requested_schema: json!({"type":"object","properties":{}}),
+            },
+        )
+        .await;
+    if !result.sent {
+        return decline();
+    }
+    result.response.unwrap_or_else(decline)
+}
+
+pub(super) async fn review(
+    session: Arc<Session>,
+    request: &ElicitationReviewRequest,
+) -> anyhow::Result<Option<ElicitationResponse>> {
+    let Some(meta) = request.elicitation.meta() else {
+        return Ok(None);
+    };
+    if request.server_name != "yijie_market"
+        || meta.get("yijieKind").and_then(Json::as_str) != Some("gateway_native_approval_v1")
+    {
+        return Ok(None);
+    }
+    let Some(reference) = meta.get("yijieMarketCallRef").and_then(Json::as_str) else {
+        return Ok(Some(decline()));
+    };
+    if uuid::Uuid::parse_str(reference).is_err()
+        || meta.len() != 2
+        || !matches!(&request.elicitation, Elicitation::Mcp(rmcp::model::CreateElicitationRequestParams::FormElicitationParams { requested_schema, .. }) if requested_schema.properties.is_empty())
+    {
+        return Ok(Some(decline()));
+    }
+    let Some((turn, cancel)) = session.active_turn_context_and_cancellation_token().await else {
+        return Ok(Some(decline()));
+    };
+    let response = tokio::select! {
+        biased;
+        _ = cancel.cancelled() => decline(),
+        result = handle(&session, &turn, reference, request) => result?,
+    };
+    Ok(Some(response))
+}
+
+async fn handle(
+    session: &Arc<Session>,
+    turn: &Arc<TurnContext>,
+    reference: &str,
+    request: &ElicitationReviewRequest,
+) -> anyhow::Result<ElicitationResponse> {
+    let facts = owner(session, turn, reference, "inspect", None, &[]).await;
+    if facts.action != ElicitationAction::Accept {
+        return Ok(decline());
+    }
+    let review: Review = serde_json::from_value(facts.content.unwrap_or(Json::Null))?;
+    if !review.arguments.is_object() || review.remaining_ms == 0 || review.remaining_ms > 60_000 {
+        return Ok(decline());
+    }
+    if let Some(key) = &review.scope
+        && (key.len() != 64
+            || !key
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)))
+    {
+        return Ok(decline());
+    }
+    let select = async {
+        let scope = review.scope.as_deref();
+        if let Some(key) = scope {
+            if mcp_permission_prompt_is_auto_approved(
+                turn.approval_policy.value(),
+                &turn.permission_profile(),
+                McpPermissionPromptAutoApproveContext::default(),
+            ) {
+                return Ok(owner(session, turn, reference, "native_full", scope, &[]).await);
+            }
+            let mut guardian = request.clone();
+            if let Elicitation::Mcp(
+                rmcp::model::CreateElicitationRequestParams::FormElicitationParams { meta, .. },
+            ) = &mut guardian.elicitation
+            {
+                *meta = Some(Meta(serde_json::from_value(json!({
+                    "codex_request_type":"approval_request","codex_approval_kind":"mcp_tool_call",
+                    "tool_name":review.tool,"tool_title":review.title,"tool_params":review.arguments
+                }))?));
+            }
+            if let Some(result) =
+                review_guardian_mcp_elicitation(Arc::clone(session), guardian).await?
+            {
+                let phase = if result.action == ElicitationAction::Accept {
+                    "native_auto"
+                } else {
+                    "native_auto_reject"
+                };
+                let ack = owner(session, turn, reference, phase, scope, &[]).await;
+                return Ok(if ack.action == ElicitationAction::Accept {
+                    result
+                } else {
+                    decline()
+                });
+            }
+            if let Some(source) =
+                crate::mcp_tool_call::market_remembered(session, key, &review.tool).await
+            {
+                return Ok(owner(session, turn, reference, source, scope, &[]).await);
+            }
+        }
+        let offers = crate::mcp_tool_call::market_persist_options(turn, scope, &review.tool);
+        let answer = owner(session, turn, reference, "user", scope, &offers).await;
+        if answer.action == ElicitationAction::Accept
+            && let Some(key) = scope
+            && let Some(requested) = answer
+                .meta
+                .as_ref()
+                .and_then(|m| m.get("persist"))
+                .and_then(Json::as_str)
+        {
+            if !offers.contains(&requested) {
+                return Ok(decline());
+            }
+            let applied = crate::mcp_tool_call::remember_market_choice(
+                session,
+                turn,
+                key,
+                &review.tool,
+                answer.clone(),
+            )
+            .await;
+            let ack = owner(session, turn, reference, applied, scope, &[]).await;
+            if ack.action != ElicitationAction::Accept {
+                return Ok(decline());
+            }
+        }
+        Ok::<_, anyhow::Error>(answer)
+    };
+    Ok(tokio::time::timeout(
+        std::time::Duration::from_millis(review.remaining_ms),
+        select,
+    )
+    .await
+    .unwrap_or_else(|_| Ok(decline()))?)
+}
