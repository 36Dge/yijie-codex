+// The dedicated Gateway clears supplier metadata before attaching this closed
+// marker. Only this turn's market server can stop its own future calls.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum MarketTurnStop {
+    Expired,
+    Revoked,
+}
+
+impl MarketTurnStop {
+    fn from_gateway(server: &str, result: &CallToolResult) -> Option<Self> {
+        if server != "yijie_market" || result.is_error != Some(true) {
+            return None;
+        }
+        match result.meta.as_ref()?.get("yijie.market.turnStop")?.as_str()? {
+            "lease_expired" => Some(Self::Expired),
+            "lease_revoked" => Some(Self::Revoked),
+            _ => None,
+        }
+    }
+
+    fn message(self) -> &'static str {
+        match self {
+            Self::Expired => "本轮市场连接器授权已到期。请停止本轮所有市场工具调用，向用户说明原因，并用现有证据继续。",
+            Self::Revoked => "本轮市场连接器授权已撤销。请停止本轮所有市场工具调用，向用户说明原因，并用现有证据继续。",
+        }
+    }
+}
+
+pub(crate) fn market_turn_stop(turn: &TurnContext) -> Option<&'static str> {
+    turn.extension_data.get::<MarketTurnStop>().map(|stop| stop.message())
+}
