+        for (command, family) in [
+            ("pnpm install", "node"),
+            ("npm ci", "node"),
+            ("cargo fetch", "cargo"),
+            ("python3 -m pip install ordinary-package", "python"),
+            (
+                "git remote set-url origin https://example.com/repo.git",
+                "git",
+            ),
+        ] {
+            assert_eq!(repair_family(command).as_deref(), Some(family));
+        }
+        for command in [
+            "echo ready",
+            "git status",
+            "git config --get remote.origin.url",
+            "pnpm run lint",
+            "python3 -c 'print(1)'",
+        ] {
+            assert_eq!(repair_family(command), None);
+        }
+        let mut complete = true;
+        fingerprint_path(
+            Path::new("/tmp"),
+            &mut Sha1::new(),
+            &mut 0,
+            0,
+            &mut complete,
+        );
+        assert!(
+            !complete,
+            "bounded observations cannot prove unchanged inputs"
+        );
