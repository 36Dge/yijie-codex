+#[cfg(test)]
+mod feat164_terminal_metrics_tests {
+    use super::*;
+    use codex_protocol::protocol::{
+        CodexErrorInfo, ErrorEvent, TurnCompleteEvent, TurnStartedEvent,
+    };
+
+    #[test]
+    fn feat164_turn_sizes_measure_sanitized_failure_bytes() {
+        let items = vec![
+            RolloutItem::EventMsg(EventMsg::TurnStarted(TurnStartedEvent {
+                turn_id: "ordinary-turn".into(),
+                trace_id: None,
+                started_at: None,
+                model_context_window: None,
+                collaboration_mode_kind: Default::default(),
+            })),
+            RolloutItem::EventMsg(EventMsg::Error(ErrorEvent {
+                message: "ordinary local diagnostic".repeat(10),
+                codex_error_info: Some(CodexErrorInfo::BadRequest),
+            })),
+            RolloutItem::EventMsg(EventMsg::TurnComplete(TurnCompleteEvent {
+                turn_id: "ordinary-turn".into(),
+                last_agent_message: None,
+                completed_at: None,
+                duration_ms: None,
+                time_to_first_token_ms: None,
+            })),
+        ];
+        let (persisted, batch) =
+            measure_and_filter_rollout_items(&items, ThreadHistoryMode::Legacy);
+        let actual: u64 = persisted
+            .iter()
+            .map(|item| serialized_len(item).unwrap())
+            .sum();
+        let mut state = TurnMeasurementState::default();
+        let turns = update_turn_measurements(&mut state, &items, &batch);
+        assert_eq!(turns.completed.len(), 1);
+        assert_eq!(turns.completed[0].totals.post_filter.payload_bytes, actual);
+        assert_eq!(batch.post_filter.payload_bytes, actual);
+        assert!(batch.pre_filter.payload_bytes > actual);
+    }
