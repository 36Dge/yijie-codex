+//! Kimi decides whether to search on the server before generating any local
+//! tool call. Offer that capability again only for a concrete outstanding fact.
+use super::History;
+use crate::function_tool::FunctionCallError;
+use crate::session::{answer_completion, public_messages, turn_context::TurnContext};
+use crate::tools::context::{FunctionToolOutput, ToolInvocation, ToolPayload, boxed_tool_output};
+use crate::tools::handlers::parse_arguments;
+use crate::tools::registry::{CoreToolRuntime, ToolExecutor};
+use codex_protocol::models::{BaseInstructions, ContentItem, ResponseItem, WebSearchAction};
+use codex_tools::{JsonSchema, ResponsesApiTool, ToolName, ToolSpec};
+use serde::Deserialize;
+use std::collections::{BTreeMap, VecDeque};
+use std::sync::{Mutex, PoisonError};
+
+pub(crate) const GAP_TOOL: &str = "request_followup_search";
+const MAX_KEYS: usize = 256;
+const USE_RESULTS: &str = "\nWhen hosted search supplies evidence in this response, check it against each part of the user's request. Once the opening has been delivered and the evidence covers the request, give the complete sourced final_answer in this response. Do not defer it to announce a finding, poll goal status, discover a duplicate retrieval route or recheck the same facts. If a further step is necessary, retain the concrete facts and sources already established.";
+const REVIEW: &str = "\nReview the evidence already obtained against the user's requested deliverable. If sufficient, start with [[yijie-public-message-v1:final_answer]] on its own line and deliver the complete answer now. The opening and previous progress were already sent. A source title or URL by itself does not establish what the page says. If a specific required fact is missing, read a relevant known page or request one focused follow-up search for that gap. When an available result includes source chunks, use them before fetching the same material again. Continue other genuinely unfinished work normally. Do not repeat a progress update or use another search route to reconfirm known facts.";
+const ALREADY_TRIED: &str = "This gap or query was already tried. Use its result, read a relevant source, or report the remaining uncertainty in your answer.";
+
+#[derive(PartialEq)]
+struct EvidenceNeed {
+    fact: String,
+    site: Option<String>,
+}
+
+#[derive(Default)]
+pub(super) struct State {
+    pub(super) searched: bool,
+    /// Exactly one subsequent provider sampling request may offer hosted search.
+    pending: Option<(EvidenceNeed, String)>,
+    offered_need: Option<EvidenceNeed>,
+    gaps: VecDeque<EvidenceNeed>,
+    queries: VecDeque<String>,
+    pub(super) last_progress: Option<String>,
+    pub(super) empty_poll: bool,
+}
+
+fn normalized(value: &str) -> String {
+    value
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ")
+        .to_lowercase()
+}
+
+// Bound bookkeeping without placing a lifetime limit on distinct research needs.
+fn remember<T: PartialEq>(values: &mut VecDeque<T>, value: T) {
+    if !values.contains(&value) {
+        if values.len() == MAX_KEYS {
+            values.pop_front();
+        }
+        values.push_back(value);
+    }
+}
+
+impl State {
+    fn observe(&mut self, action: &WebSearchAction) {
+        let WebSearchAction::Search { query, queries, .. } = action else {
+            return;
+        };
+        self.searched = true;
+        if let Some(need) = self.offered_need.take() {
+            remember(&mut self.gaps, need);
+        }
+        for value in query.iter().chain(queries.iter().flatten()) {
+            if value.len() <= 4096 {
+                remember(&mut self.queries, normalized(value));
+            }
+        }
+    }
+
+    fn request(&mut self, gap: &Gap) -> Result<(), &'static str> {
+        if !self.searched || self.pending.is_some() {
+            return Err("A further search decision is not needed in this step.");
+        }
+        if [&gap.missing_fact, &gap.query]
+            .iter()
+            .any(|s| s.trim().is_empty() || s.len() > 1024)
+        {
+            return Err("Specify the missing fact and a concise query targeting it.");
+        }
+        let query = normalized(&gap.query);
+        // A lookup at a different named source can still resolve the same gap.
+        let source = query
+            .split_whitespace()
+            .find_map(|s| s.strip_prefix("site:").filter(|site| !site.is_empty()))
+            .map(str::to_owned);
+        let fact = EvidenceNeed {
+            fact: normalized(&gap.missing_fact),
+            site: source,
+        };
+        if self.gaps.contains(&fact) || self.queries.contains(&query) {
+            return Err(ALREADY_TRIED);
+        }
+        self.pending = Some((fact, query));
+        Ok(())
+    }
+
+    fn begin_request(&mut self) {
+        // Offering the capability does not prove that the provider searched.
+        // Close the exact attempt, and mark the fact searched only on its receipt.
+        self.offered_need = self.pending.take().map(|(fact, query)| {
+            remember(&mut self.queries, query);
+            fact
+        });
+    }
+
+    pub(super) fn reviewing(&self) -> bool {
+        self.searched && self.pending.is_none()
+    }
+
+    pub(super) fn reconsider(&mut self) {
+        self.pending = None;
+    }
+
+    fn prepare(
+        &self,
+        specs: &mut Vec<ToolSpec>,
+        input: &mut Vec<ResponseItem>,
+        instructions: &mut BaseInstructions,
+    ) {
+        let review = self.reviewing();
+        specs.retain(|spec| match spec {
+            ToolSpec::WebSearch { .. } => !review,
+            ToolSpec::Function(f) if f.name == GAP_TOOL => review,
+            _ => true,
+        });
+        if review {
+            input.push(ResponseItem::Message {
+                id: None,
+                role: "developer".into(),
+                content: vec![ContentItem::InputText {
+                    text: REVIEW.trim().into(),
+                }],
+                phase: None,
+                internal_chat_message_metadata_passthrough: None,
+            });
+        } else {
+            instructions.text.push_str(USE_RESULTS);
+        }
+    }
+}
+
+pub(crate) fn enabled(turn: &TurnContext) -> bool {
+    turn.model_info.slug == "kimi-k3.1-pro"
+        && public_messages::enabled(turn)
+        && !turn.session_source.is_non_root_agent()
+        && !turn.dynamic_tools.iter().any(|s| matches!(s, codex_protocol::dynamic_tools::DynamicToolSpec::Function(f) if f.name == GAP_TOOL))
+        && turn
+            .developer_instructions
+            .as_deref()
+            .is_some_and(|s| s.contains(answer_completion::MARKER))
+}
+
+fn with_state<T>(turn: &TurnContext, f: impl FnOnce(&mut State) -> T) -> T {
+    let state = turn
+        .extension_data
+        .get_or_init(|| Mutex::new(History::default()));
+    f(&mut state.lock().unwrap_or_else(PoisonError::into_inner).hosted)
+}
+
+pub(crate) fn observe(turn: &TurnContext, action: &WebSearchAction) {
+    if enabled(turn) {
+        with_state(turn, |state| state.observe(action));
+    }
+}
+
+pub(crate) fn prepare(
+    turn: &TurnContext,
+    specs: &mut Vec<ToolSpec>,
+    input: &mut Vec<ResponseItem>,
+    instructions: &mut BaseInstructions,
+) {
+    // These two specs are registered together only when the original provider,
+    // mode and permission configuration offers hosted search.
+    if enabled(turn)
+        && specs
+            .iter()
+            .any(|s| matches!(s, ToolSpec::WebSearch { .. }))
+        && specs
+            .iter()
+            .any(|s| matches!(s, ToolSpec::Function(f) if f.name == GAP_TOOL))
+    {
+        with_state(turn, |state| state.prepare(specs, input, instructions));
+    }
+}
+
+pub(crate) fn sampling_started(turn: &TurnContext) {
+    if enabled(turn) {
+        with_state(turn, State::begin_request);
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Gap {
+    missing_fact: String,
+    query: String,
+}
+
+pub(crate) struct RequestFollowup;
+
+impl ToolExecutor<ToolInvocation> for RequestFollowup {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain(GAP_TOOL)
+    }
+
+    fn spec(&self) -> ToolSpec {
+        let fields = BTreeMap::from([
+            ("missing_fact".into(), JsonSchema::string(Some("Which specific part of the user's request is still unsupported by the available evidence?".into()))),
+            ("query".into(), JsonSchema::string(Some("A targeted lookup that would resolve that gap. For an untried source on the same missing fact, include site:domain.".into()))),
+        ]);
+        ToolSpec::Function(ResponsesApiTool {
+            name: GAP_TOOL.into(),
+            description: "Request hosted search in the next step only for a missing fact. If the material already covers the user's request, answer now. Do not call to recheck results or announce progress.".into(),
+            strict: true,
+            defer_loading: None,
+            parameters: JsonSchema::object(fields, Some(vec!["missing_fact".into(), "query".into()]), Some(false.into())),
+            output_schema: None,
+        })
+    }
+
+    fn handle(&self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'_> {
+        Box::pin(async move {
+            let ToolPayload::Function { arguments } = &invocation.payload else {
+                return Err(FunctionCallError::RespondToModel(
+                    "Expected a missing fact and query.".into(),
+                ));
+            };
+            if !invocation
+                .step_context
+                .search_progress
+                .lock()
+                .unwrap_or_else(PoisonError::into_inner)
+                .gap_offered
+            {
+                return Err(FunctionCallError::RespondToModel(
+                    "Follow-up search was not offered in this sampling step.".into(),
+                ));
+            }
+            let gap: Gap = parse_arguments(arguments)?;
+            let decision = with_state(&invocation.turn, |state| state.request(&gap));
+            if let Err(reason) = decision {
+                invocation
+                    .step_context
+                    .search_progress
+                    .lock()
+                    .unwrap_or_else(PoisonError::into_inner)
+                    .refused_gap = true;
+                return Err(FunctionCallError::RespondToModel(reason.into()));
+            }
+            Ok(boxed_tool_output(FunctionToolOutput::from_text(
+                format!(
+                    "The next request may use hosted search for this missing fact. Answer as soon as the results cover it.\n{}",
+                    serde_json::json!({"missing_fact": gap.missing_fact, "query": gap.query})
+                ),
+                Some(true),
+            )))
+        })
+    }
+}
+impl CoreToolRuntime for RequestFollowup {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn evidence_review_keeps_other_tools_and_does_not_modify_the_actual_history() {
+        let web = crate::tools::hosted_spec::create_web_search_tool(
+            crate::tools::hosted_spec::WebSearchToolOptions {
+                web_search_mode: Some(codex_protocol::config_types::WebSearchMode::Live),
+                web_search_config: None,
+                web_search_tool_type: codex_protocol::openai_models::WebSearchToolType::Text,
+            },
+        )
+        .unwrap();
+        let ToolSpec::Function(mut independent) = RequestFollowup.spec() else {
+            unreachable!()
+        };
+        independent.name = "ordinary_work".into();
+        let specs = vec![web, RequestFollowup.spec(), ToolSpec::Function(independent)];
+        let check = |state: &State, review: bool| {
+            let mut offered = specs.clone();
+            let mut input = Vec::new();
+            let mut prompt = BaseInstructions {
+                text: String::new(),
+            };
+            state.prepare(&mut offered, &mut input, &mut prompt);
+            let names: Vec<_> = offered.iter().map(ToolSpec::name).collect();
+            assert!(names.contains(&"ordinary_work"));
+            assert_eq!(names.contains(&GAP_TOOL), review);
+            assert_eq!(names.contains(&"web_search"), !review);
+            assert_eq!(input.len(), usize::from(review));
+        };
+        let mut state = State::default();
+        check(&state, false);
+        state.observe(&WebSearchAction::Search {
+            query: None,
+            queries: None,
+            sources: None,
+        });
+        check(&state, true);
+        state
+            .request(&Gap {
+                missing_fact: "population".into(),
+                query: "city census".into(),
+            })
+            .unwrap();
+        check(&state, false);
+        state.begin_request();
+        check(&state, true);
+        // This time the provider returned without searching. A better query
+        // for the same still-missing fact remains admissible.
+        assert!(
+            state
+                .request(&Gap {
+                    missing_fact: "population".into(),
+                    query: "municipal statistics office population".into()
+                })
+                .is_ok()
+        );
+    }
+
+    #[test]
+    fn followup_requires_new_evidence_need_and_one_search_opportunity() {
+        let gap = Gap {
+            missing_fact: "last day's forecast".into(),
+            query: "City A November 30".into(),
+        };
+        let mut state = State::default();
+        assert!(state.request(&gap).is_err());
+        let first = WebSearchAction::Search {
+            query: Some("City A week".into()),
+            queries: None,
+            sources: None,
+        };
+        state.observe(&first);
+        assert!(
+            state
+                .request(&Gap {
+                    missing_fact: gap.missing_fact.clone(),
+                    query: " CITY A   week ".into()
+                })
+                .is_err()
+        );
+        assert!(state.request(&gap).is_ok());
+        assert!(!state.reviewing());
+        assert!(state.request(&gap).is_err());
+        state.begin_request();
+        state.observe(&first);
+        assert!(state.reviewing());
+        assert!(state.request(&gap).is_err());
+        assert!(
+            state
+                .request(&Gap {
+                    missing_fact: gap.missing_fact.clone(),
+                    query: "city November 30 site:example.org".into()
+                })
+                .is_ok()
+        );
+        state.reconsider();
+        assert!(state.reviewing());
+        assert!(
+            state
+                .request(&Gap {
+                    missing_fact: "City B forecast".into(),
+                    query: "City B November 30".into()
+                })
+                .is_ok()
+        );
+    }
+}
