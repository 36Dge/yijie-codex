+#[tokio::test]
+async fn native_tools_audit_function_alias_keeps_code_mode_namespace_policy() {
+    for direct_only in [false, true] {
+        let plan = probe_with(
+            |turn| {
+                set_features(turn, &[Feature::CodeMode]);
+                update_config(turn, |config| {
+                    config.code_mode.function_namespaces = vec!["memories".to_string()];
+                    if direct_only {
+                        config.code_mode.direct_only_tool_namespaces = vec!["memories".to_string()];
+                    } else {
+                        config.code_mode.excluded_tool_namespaces = vec!["memories".to_string()];
+                    }
+                });
+            },
+            ToolPlanInputs {
+                dynamic_tools: vec![dynamic_tool(Some("memories"), "audit_sample_read", false)],
+                ..ToolPlanInputs::default()
+            },
+        )
+        .await;
+        plan.assert_visible_contains(&["memories__audit_sample_read"]);
+        let ToolSpec::Freeform(exec) = plan.visible_spec(codex_code_mode::PUBLIC_TOOL_NAME) else {
+            panic!("native exec spec missing")
+        };
+        assert!(
+            !exec.description.contains("audit_sample_read"),
+            "adapted namespace escaped its existing Code Mode restriction"
+        );
+        if direct_only {
+            assert_eq!(
+                plan.exposure("memories__audit_sample_read"),
+                ToolExposure::DirectModelOnly
+            );
+        }
+    }
+}
