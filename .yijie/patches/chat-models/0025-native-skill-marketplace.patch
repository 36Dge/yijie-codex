diff --git a/core-plugins/src/manager/managed.rs b/core-plugins/src/manager/managed.rs
new file mode 100644
--- /dev/null
+++ b/core-plugins/src/manager/managed.rs
@@ -0,0 +1,382 @@
+//! Bounded facts and a bridge to the existing local refresh machinery.
+use super::*;
+use std::collections::BTreeSet;
+use std::fs;
+
+#[derive(Debug)]
+pub struct ManagedPluginState {
+    pub plugin_id: String,
+    pub user_enabled: Option<bool>,
+    pub effective_enabled: bool,
+    pub cache_version: Option<String>,
+    pub cache_present: bool,
+    pub manifest_valid: bool,
+    pub catalog_listed: bool,
+    pub skills: Vec<SkillMetadata>,
+    pub disabled_paths: HashSet<AbsolutePathBuf>,
+    pub errors: Vec<String>,
+}
+
+impl PluginsManager {
+    pub async fn managed_plugin_states(
+        &self,
+        config: &PluginsConfigInput,
+        requested: &[String],
+        marketplaces: &[String],
+    ) -> Result<Vec<ManagedPluginState>, String> {
+        if requested.len() > 512 || marketplaces.len() > 16 {
+            return Err("plugin state request is too large".into());
+        }
+        if self
+            .non_curated_cache_refresh_state
+            .read()
+            .map_err(|_| "plugin refresh state unavailable")?
+            .in_flight
+        {
+            return Err("plugin_refresh_busy".into());
+        }
+        let allowed = crate::local_policy::allowed_names(&config.config_layer_stack);
+        if !config.local_only() || marketplaces.iter().any(|m| !allowed.contains(m)) {
+            return Err("plugin state requires an admitted local marketplace".into());
+        }
+        let user = config
+            .config_layer_stack
+            .effective_user_config()
+            .unwrap_or_else(|| toml::Value::Table(Default::default()));
+        let raw = user.get("plugins").and_then(toml::Value::as_table);
+        let effective =
+            configured_plugins_from_stack(&config.config_layer_stack, self.codex_home.as_path());
+        let mut ids = BTreeSet::new();
+        for value in requested {
+            let id = PluginId::parse(value).map_err(|_| "invalid plugin identity")?;
+            if !allowed.contains(&id.marketplace_name) {
+                return Err("plugin marketplace is not admitted".into());
+            }
+            ids.insert(value.clone());
+        }
+        for name in marketplaces {
+            codex_plugin::validate_plugin_segment(name, "marketplace")
+                .map_err(|_| "invalid marketplace")?;
+            if let Some(raw) = raw {
+                for key in raw.keys() {
+                    if PluginId::parse(key).is_ok_and(|id| id.marketplace_name == *name) {
+                        ids.insert(key.clone());
+                    }
+                }
+            }
+            let directory = self.store.root().join(name);
+            match fs::read_dir(directory.as_path()) {
+                Ok(entries) => {
+                    for entry in entries {
+                        let entry = entry.map_err(|_| "plugin cache unreadable")?;
+                        let name = entry
+                            .file_name()
+                            .into_string()
+                            .map_err(|_| "plugin cache name unavailable")?;
+                        if name.starts_with("plugin-install-") || name.starts_with("plugin-backup-")
+                        {
+                            continue;
+                        }
+                        let market = directory
+                            .as_path()
+                            .file_name()
+                            .and_then(|v| v.to_str())
+                            .ok_or("invalid cache marketplace")?;
+                        if let Ok(id) = PluginId::new(name, market.to_owned()) {
+                            ids.insert(id.as_key());
+                        }
+                        if ids.len() > 512 {
+                            return Err("plugin inventory exceeds the request limit".into());
+                        }
+                    }
+                }
+                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+                Err(_) => return Err("plugin cache unreadable".into()),
+            }
+        }
+        let roots = crate::local_policy::roots(&config.config_layer_stack);
+        let listed = crate::marketplace::list_marketplaces_with_home(&roots, None)
+            .map_err(|_| "local marketplace inventory unavailable")?;
+        let catalog_error = !listed.errors.is_empty();
+        let listed_ids: HashSet<String> = listed
+            .marketplaces
+            .iter()
+            .flat_map(|market| {
+                market
+                    .plugins
+                    .iter()
+                    .map(|p| format!("{}@{}", p.name, market.name))
+            })
+            .collect();
+        let rules = skill_config_rules_from_stack(&config.config_layer_stack);
+        let mut result = Vec::with_capacity(ids.len());
+        for value in ids {
+            let id = PluginId::parse(&value).map_err(|_| "invalid plugin identity")?;
+            let base = self.store.plugin_base_root(&id);
+            let present = base
+                .as_path()
+                .try_exists()
+                .map_err(|_| "plugin cache unreadable")?;
+            if present {
+                fs::read_dir(base.as_path()).map_err(|_| "plugin cache unreadable")?;
+            }
+            let version = self.store.active_plugin_version(&id);
+            let user_enabled = raw
+                .and_then(|v| v.get(&value))
+                .map(|v| v.clone().try_into::<codex_config::types::PluginConfig>())
+                .transpose()
+                .map_err(|_| "plugin user configuration is invalid")?
+                .map(|v| v.enabled);
+            let enabled =
+                config.plugins_enabled && effective.get(&value).is_some_and(|p| p.enabled);
+            let mut state = ManagedPluginState {
+                plugin_id: value.clone(),
+                user_enabled,
+                effective_enabled: enabled,
+                cache_version: version,
+                cache_present: present,
+                manifest_valid: false,
+                catalog_listed: listed_ids.contains(&value),
+                skills: Vec::new(),
+                disabled_paths: HashSet::new(),
+                errors: Vec::new(),
+            };
+            if catalog_error {
+                state.errors.push("catalog_unavailable".into());
+            }
+            if let Some(root) = self.store.active_plugin_root(&id) {
+                if let Some(manifest) =
+                    load_plugin_manifest(root.as_path()).filter(|m| m.name == id.plugin_name)
+                {
+                    let parsed = load_plugin_skills(
+                        &root,
+                        &id,
+                        &manifest,
+                        self.restriction_product,
+                        &rules,
+                        None,
+                    )
+                    .await;
+                    state.manifest_valid = !parsed.had_errors;
+                    state.skills = parsed.skills;
+                    state.disabled_paths = parsed.disabled_skill_paths;
+                }
+            }
+            if present && !state.manifest_valid {
+                state.errors.push("cache_invalid".into());
+            }
+            result.push(state);
+        }
+        Ok(result)
+    }
+
+    pub async fn refresh_managed_plugin(
+        &self,
+        config: &PluginsConfigInput,
+        plugin_key: &str,
+        marketplace_path: &AbsolutePathBuf,
+        force: bool,
+    ) -> Result<bool, String> {
+        if !config.local_only() || !config.explicit_refresh() {
+            return Err("explicit local refresh is not enabled".into());
+        }
+        if self
+            .non_curated_cache_refresh_state
+            .read()
+            .map_err(|_| "plugin refresh state unavailable")?
+            .in_flight
+        {
+            return Err("plugin_refresh_busy".into());
+        }
+        let id = PluginId::parse(plugin_key).map_err(|_| "invalid plugin identity")?;
+        let resolved = find_marketplace_plugin(marketplace_path, &id.plugin_name)
+            .map_err(|_| "plugin source unavailable")?;
+        if resolved.plugin_id != id {
+            return Err("plugin source identity differs".into());
+        }
+        crate::local_policy::validate_source(
+            &config.config_layer_stack,
+            marketplace_path,
+            &resolved.source,
+        )?;
+        MarketplacePolicy::from_requirements(config.config_layer_stack.requirements())
+            .validate_install(
+                &config.config_layer_stack,
+                self.codex_home.as_path(),
+                marketplace_path,
+                &id.marketplace_name,
+            )?;
+        let configured =
+            configured_plugins_from_stack(&config.config_layer_stack, self.codex_home.as_path());
+        if !configured.contains_key(plugin_key) {
+            return Err("plugin is not configured; first install is required".into());
+        }
+        let root = crate::marketplace::marketplace_root_dir(marketplace_path)
+            .map_err(|_| "invalid marketplace layout")?;
+        let outcome = if force {
+            refresh_non_curated_plugin_cache_force_reinstall_detailed(
+                self.codex_home.as_path(),
+                &[root],
+                &[plugin_key.to_owned()],
+            )
+        } else {
+            refresh_non_curated_plugin_cache_detailed(
+                self.codex_home.as_path(),
+                &[root],
+                &[plugin_key.to_owned()],
+            )
+        }?;
+        self.clear_caches_after_marketplace_source_refresh(outcome.cache_refreshed);
+        if !outcome.errors.is_empty() {
+            return Err("native plugin refresh failed; inspect state before retry".into());
+        }
+        Ok(outcome.cache_refreshed)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn input(home: &Path, root: &Path, enabled: Option<bool>) -> PluginsConfigInput {
+        let mut value = serde_json::json!({
+            "plugin_marketplace_mode":"local_only", "plugin_refresh_mode":"explicit",
+            "plugin_allowed_local_roots":[root.to_str().unwrap()],
+            "marketplaces":{"local":{"source_type":"local","source":root.to_str().unwrap()}}
+        });
+        if let Some(enabled) = enabled {
+            value["plugins"] = serde_json::json!({"plain@local":{"enabled":enabled}});
+        }
+        let config = codex_config::ConfigLayerStack::default().with_user_config(
+            &AbsolutePathBuf::try_from(home.join("config.toml")).unwrap(),
+            toml::Value::try_from(value).unwrap(),
+        );
+        PluginsConfigInput::new(config, true, false, String::new())
+    }
+    fn source(root: &Path, version: &str) -> AbsolutePathBuf {
+        let dir = root.join(format!("plugin-{version}"));
+        fs::create_dir_all(dir.join(".codex-plugin")).unwrap();
+        fs::create_dir_all(dir.join("skills/main")).unwrap();
+        fs::write(
+            dir.join(".codex-plugin/plugin.json"),
+            serde_json::to_vec(
+                &serde_json::json!({"name":"plain","version":version,"skills":"./skills"}),
+            )
+            .unwrap(),
+        )
+        .unwrap();
+        fs::write(dir.join("skills/main/SKILL.md"), "---\nname: plain\ndescription: Ordinary arithmetic explanation.\n---\nExplain six times seven.\n").unwrap();
+        fs::create_dir_all(root.join(".agents/plugins")).unwrap();
+        fs::write(root.join(".agents/plugins/marketplace.json"), serde_json::to_vec(&serde_json::json!({"name":"local","plugins":[{"name":"plain","source":format!("./plugin-{version}")}]})).unwrap()).unwrap();
+        AbsolutePathBuf::try_from(dir).unwrap()
+    }
+    #[tokio::test]
+    async fn managed_plugin_inventory_separates_cache_configuration_and_catalog() {
+        let temp = tempfile::tempdir().unwrap();
+        let home = temp.path().join("home");
+        let root = temp.path().join("catalog");
+        fs::create_dir_all(&home).unwrap();
+        let src = source(&root, "1.0.0");
+        let manager = PluginsManager::new(home.clone());
+        let config = input(&home, &root, None);
+        let absent = manager
+            .managed_plugin_states(&config, &["plain@local".into()], &[])
+            .await
+            .unwrap();
+        assert!(!absent[0].cache_present);
+        assert!(absent[0].user_enabled.is_none());
+        assert!(absent[0].catalog_listed);
+        manager
+            .store
+            .install(src, PluginId::parse("plain@local").unwrap())
+            .unwrap();
+        let partial = manager
+            .managed_plugin_states(&config, &[], &["local".into()])
+            .await
+            .unwrap();
+        assert!(partial[0].manifest_valid);
+        assert!(partial[0].user_enabled.is_none());
+        assert_eq!(partial[0].skills.len(), 1);
+        fs::write(
+            root.join(".agents/plugins/marketplace.json"),
+            r#"{"name":"local","plugins":[]}"#,
+        )
+        .unwrap();
+        let disabled = manager
+            .managed_plugin_states(&input(&home, &root, Some(false)), &[], &["local".into()])
+            .await
+            .unwrap();
+        assert!(disabled[0].cache_present);
+        assert_eq!(disabled[0].user_enabled, Some(false));
+        assert!(!disabled[0].catalog_listed);
+        assert!(!disabled[0].effective_enabled);
+        manager
+            .store
+            .uninstall(&PluginId::parse("plain@local").unwrap())
+            .unwrap();
+        let config_only = manager
+            .managed_plugin_states(&input(&home, &root, Some(false)), &[], &["local".into()])
+            .await
+            .unwrap();
+        assert!(!config_only[0].cache_present);
+        assert_eq!(config_only[0].user_enabled, Some(false));
+    }
+    #[tokio::test]
+    async fn managed_plugin_native_refresh_and_rollback_preserve_disabled_intent() {
+        let temp = tempfile::tempdir().unwrap();
+        let home = temp.path().join("home");
+        let root = temp.path().join("catalog");
+        fs::create_dir_all(&home).unwrap();
+        let src = source(&root, "1.0.0");
+        let manager = PluginsManager::new(home.clone());
+        let id = PluginId::parse("plain@local").unwrap();
+        manager.store.install(src, id.clone()).unwrap();
+        let config = input(&home, &root, Some(false));
+        let manifest =
+            AbsolutePathBuf::try_from(root.join(".agents/plugins/marketplace.json")).unwrap();
+        source(&root, "2.0.0");
+        assert!(
+            manager
+                .refresh_managed_plugin(&config, "plain@local", &manifest, false)
+                .await
+                .unwrap()
+        );
+        assert_eq!(
+            manager.store.active_plugin_version(&id).as_deref(),
+            Some("2.0.0")
+        );
+        source(&root, "1.0.0");
+        assert!(
+            manager
+                .refresh_managed_plugin(&config, "plain@local", &manifest, true)
+                .await
+                .unwrap()
+        );
+        let state = manager
+            .managed_plugin_states(&config, &["plain@local".into()], &[])
+            .await
+            .unwrap();
+        assert_eq!(state[0].cache_version.as_deref(), Some("1.0.0"));
+        assert_eq!(state[0].user_enabled, Some(false));
+        assert!(!state[0].effective_enabled);
+    }
+    #[test]
+    fn managed_plugin_policy_keeps_existing_defaults_and_scopes_local_sources() {
+        assert!(!crate::local_policy::local_only(
+            &codex_config::ConfigLayerStack::default()
+        ));
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().join("catalog");
+        source(&root, "1.0.0");
+        let config = input(temp.path(), &root, None);
