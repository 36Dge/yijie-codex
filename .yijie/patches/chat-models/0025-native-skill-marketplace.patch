diff --git a/core-plugins/src/local_policy.rs b/core-plugins/src/local_policy.rs
new file mode 100644
--- /dev/null
+++ b/core-plugins/src/local_policy.rs
@@ -0,0 +1,98 @@
+//! Optional managed-local policy. Catalog and install machinery remain native.
+use crate::marketplace::{MarketplacePluginSource, marketplace_root_dir};
+use codex_config::ConfigLayerStack;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use std::path::{Path, PathBuf};
+
+pub fn local_only(stack: &ConfigLayerStack) -> bool {
+    stack
+        .effective_config()
+        .get("plugin_marketplace_mode")
+        .and_then(toml::Value::as_str)
+        == Some("local_only")
+}
+pub fn explicit_refresh(stack: &ConfigLayerStack) -> bool {
+    stack
+        .effective_config()
+        .get("plugin_refresh_mode")
+        .and_then(toml::Value::as_str)
+        == Some("explicit")
+}
+pub fn roots(stack: &ConfigLayerStack) -> Vec<AbsolutePathBuf> {
+    stack
+        .effective_config()
+        .get("plugin_allowed_local_roots")
+        .and_then(toml::Value::as_array)
+        .into_iter()
+        .flatten()
+        .filter_map(toml::Value::as_str)
+        .filter_map(|p| AbsolutePathBuf::try_from(PathBuf::from(p)).ok())
+        .collect()
+}
+pub fn allows_root(stack: &ConfigLayerStack, root: &Path) -> bool {
+    if !local_only(stack) {
+        return true;
+    }
+    let Ok(root) = root.canonicalize() else {
+        return false;
+    };
+    roots(stack)
+        .iter()
+        .any(|p| p.as_path().canonicalize().is_ok_and(|p| p == root))
+}
+pub fn validate_marketplace(
+    stack: &ConfigLayerStack,
+    path: &AbsolutePathBuf,
+) -> Result<(), String> {
+    if !local_only(stack) {
+        return Ok(());
+    }
+    let root = marketplace_root_dir(path).map_err(|e| e.to_string())?;
+    if !allows_root(stack, root.as_path()) {
+        return Err("plugin marketplace is outside the configured local roots".into());
+    }
+    Ok(())
+}
+pub fn validate_source(
+    stack: &ConfigLayerStack,
+    path: &AbsolutePathBuf,
+    source: &MarketplacePluginSource,
+) -> Result<(), String> {
+    validate_marketplace(stack, path)?;
+    if !local_only(stack) {
+        return Ok(());
+    }
+    let MarketplacePluginSource::Local { path: source } = source else {
+        return Err("managed-local plugins require a local source".into());
+    };
+    let root = marketplace_root_dir(path)
+        .map_err(|e| e.to_string())?
+        .as_path()
+        .canonicalize()
+        .map_err(|_| "local marketplace is unavailable")?;
+    let source = source
+        .as_path()
+        .canonicalize()
+        .map_err(|_| "local plugin source is unavailable")?;
+    if !source.starts_with(root) {
+        return Err("local plugin source is outside its marketplace".into());
+    }
+    Ok(())
+}
+pub fn allowed_names(stack: &ConfigLayerStack) -> std::collections::HashSet<String> {
+    let config = stack.effective_user_config();
+    config
+        .as_ref()
+        .and_then(|c| c.get("marketplaces"))
+        .and_then(toml::Value::as_table)
+        .into_iter()
+        .flatten()
+        .filter_map(|(name, entry)| {
+            (entry.get("source_type").and_then(toml::Value::as_str) == Some("local"))
+                .then(|| entry.get("source").and_then(toml::Value::as_str))
+                .flatten()
+                .filter(|p| allows_root(stack, Path::new(p)))
+                .map(|_| name.clone())
+        })
+        .collect()
+}
