+        effective_enabled: state.effective_enabled,
+        cache_state: if !state.cache_present {
+            PluginCacheState::Absent
+        } else if state.manifest_valid {
+            PluginCacheState::Valid
+        } else {
+            PluginCacheState::Invalid
+        },
+        cache_version: state.cache_version,
+        manifest_valid: state.manifest_valid,
+        catalog_listed: state.catalog_listed,
+        skills,
+        errors: state.errors,
