+fn preserve_function_search_direct_tools(turn: &TurnContext, planned: &mut PlannedTools) {
+    if turn.model_info.tool_search_transport != Some(ToolSearchTransport::FunctionCodeMode) {
+        return;
+    }
+    for runtime in &mut planned.runtimes {
+        if runtime.exposure() == ToolExposure::Deferred
