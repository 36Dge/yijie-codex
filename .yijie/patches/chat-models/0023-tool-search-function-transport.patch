+
+#[tokio::test]
+async fn tool_search_function_transport_catalog_is_thread_scoped() {
+    let base = remote_model("ordinary-model", "Ordinary", 1);
+    let mut selected = base.clone();
+    selected.supports_search_tool = true;
+    selected.tool_search_transport =
+        Some(codex_protocol::openai_models::ToolSearchTransport::FunctionCodeMode);
+    selected.description = Some("Thread description must not replace unrelated metadata".into());
+    let manager = static_manager_for_tests(ModelsResponse {
+        models: vec![base.clone()],
+    });
+    let normal = ModelsManagerConfig::default();
+    let ordinary = ModelsManagerConfig {
+        model_catalog: Some(ModelsResponse {
+            models: vec![selected],
+        }),
+        ..normal.clone()
+    };
+    let resolved = manager.get_model_info("ordinary-model", &ordinary).await;
+    assert!(resolved.supports_search_tool);
+    assert_eq!(
+        resolved.tool_search_transport,
+        Some(codex_protocol::openai_models::ToolSearchTransport::FunctionCodeMode)
+    );
+    assert_eq!(resolved.description, base.description);
+    let auxiliary = manager.get_model_info("ordinary-model", &normal).await;
+    assert_eq!(auxiliary.supports_search_tool, base.supports_search_tool);
+    assert_eq!(auxiliary.tool_search_transport, None);
+    let disabled = ModelsManagerConfig {
+        model_catalog: Some(ModelsResponse {
+            models: vec![base.clone()],
+        }),
+        ..normal
+    };
+    assert_eq!(
+        manager
+            .get_model_info("ordinary-model", &disabled)
+            .await
+            .supports_search_tool,
+        base.supports_search_tool
+    );
+}
