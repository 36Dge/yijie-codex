+                || codex_tools::collect_code_mode_tool_definitions(std::iter::once(
+                    &runtime.spec(),
+                ))
+                .is_empty())
+        {
+            *runtime = override_tool_exposure(Arc::clone(runtime), ToolExposure::DirectModelOnly);
+        }
+    }
