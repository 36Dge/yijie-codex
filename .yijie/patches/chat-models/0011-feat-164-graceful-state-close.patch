+        manager.spawn_listener(async {});
+        drop(registration);
+        assert!(manager.shutdown_listeners().await);
+        let other_registration = other.begin_listener_registration().unwrap();
+        drop(other_registration);
+        assert!(other.shutdown_listeners().await);
+    }
+}
