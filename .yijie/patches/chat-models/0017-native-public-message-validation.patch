+//! Standalone control-line projection using the existing incremental line parser.
+//! Inline text, blockquotes, indented code and fenced code remain literal.
+use crate::StreamTextChunk;
+use crate::StreamTextParser;
+use crate::tagged_line_parser::{TagSpec, TaggedLineParser, TaggedLineSegment};
+
+#[derive(Debug)]
+pub struct StandaloneMarkerParser {
+    parser: TaggedLineParser<usize>,
+}
+
+impl StandaloneMarkerParser {
+    pub fn new(markers: &[&'static str]) -> Self {
+        Self {
+            parser: TaggedLineParser::new_standalone(
+                markers
+                    .iter()
+                    .enumerate()
+                    .map(|(tag, marker)| TagSpec {
+                        open: marker,
+                        close: marker,
+                        tag,
+                    })
+                    .collect(),
+            ),
+        }
+    }
+}
+
+fn mapped(segments: Vec<TaggedLineSegment<usize>>) -> StreamTextChunk<usize> {
+    let mut chunk = StreamTextChunk::default();
+    for segment in segments {
+        match segment {
+            TaggedLineSegment::Normal(text) | TaggedLineSegment::TagDelta(_, text) => {
+                chunk.visible_text.push_str(&text)
+            }
+            TaggedLineSegment::TagStart(index) => chunk.extracted.push(index),
+            TaggedLineSegment::TagEnd(_) => {}
+        }
+    }
+    chunk
+}
+
+impl StreamTextParser for StandaloneMarkerParser {
+    type Extracted = usize;
+
+    fn push_str(&mut self, text: &str) -> StreamTextChunk<usize> {
+        mapped(self.parser.parse(text))
+    }
+
+    fn finish(&mut self) -> StreamTextChunk<usize> {
+        mapped(self.parser.finish())
+    }
+}
