+    #[test]
+    fn standalone_markers_preserve_prose_and_quoted_examples_at_each_boundary() {
+        let input = "说明。\n<first>\n正文。\ninline <second> text\n> <second>\n    <second>\n```text\n<second>\n```\n~~~\n<first>\n~~~\n  <second>  \r\n最后。";
+        let expected = "说明。\n正文。\ninline <second> text\n> <second>\n    <second>\n```text\n<second>\n```\n~~~\n<first>\n~~~\n最后。";
+        for split in 0..=input.len() {
+            if !input.is_char_boundary(split) {
+                continue;
+            }
+            let mut parser = StandaloneMarkerParser::new(&["<first>", "<second>"]);
+            let mut text = String::new();
+            let mut found = Vec::new();
+            for part in [
+                parser.push_str(&input[..split]),
+                parser.push_str(&input[split..]),
+                parser.finish(),
+            ] {
+                text.push_str(&part.visible_text);
+                found.extend(part.extracted);
+            }
+            assert_eq!(text, expected);
+            assert_eq!(found, [0, 1]);
+        }
+    }
+
+    #[test]
+    fn standalone_markers_require_a_whole_unquoted_line_and_matching_fence() {
+        let input = "````\n<first>\n```\n<second>\n````\n<first> extra\n<second>";
+        let mut parser = StandaloneMarkerParser::new(&["<first>", "<second>"]);
+        let first = parser.push_str(input);
+        let last = parser.finish();
+        assert_eq!(
+            first.visible_text + &last.visible_text,
+            "````\n<first>\n```\n<second>\n````\n<first> extra\n"
+        );
+        assert_eq!(last.extracted, [1]);
+    }
+}
