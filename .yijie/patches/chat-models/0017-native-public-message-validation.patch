+/// A bounded, allocation-free fence observation. Only standalone marker mode
+/// uses it; the established tag-block parser retains its original behavior.
+#[derive(Debug, Default)]
+struct FenceLine {
+    indent: usize,
+    marker: Option<char>,
+    run: usize,
+    in_run: bool,
+    invalid: bool,
+    clean_tail: bool,
+    valid_open: bool,
+}
+
+impl FenceLine {
+    fn push(&mut self, ch: char) {
+        if ch == '\n' {
+            return;
+        }
+        if self.invalid {
+            return;
+        }
+        if self.marker.is_none() {
+            if ch == ' ' {
+                self.indent += 1;
+                self.invalid = self.indent >= 4;
+            } else if ch == '`' || ch == '~' {
+                self.marker = Some(ch);
+                self.run = 1;
+                self.in_run = true;
+                self.clean_tail = true;
+                self.valid_open = true;
+            } else {
+                self.invalid = true;
+            }
+        } else if self.in_run && self.marker == Some(ch) {
+            self.run = self.run.saturating_add(1);
+        } else {
+            self.in_run = false;
+            self.clean_tail &= ch.is_whitespace();
+            if self.marker == Some('`') && ch == '`' {
+                self.valid_open = false;
+            }
+        }
+    }
 }
 
