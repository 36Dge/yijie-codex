+#[tokio::test]
+async fn early_sandbox_denial_forces_failed_lifecycle_without_rewriting_exit_code() {
+    let (session, turn, rx_event) = crate::session::tests::make_session_and_context_with_rx().await;
+    let context = UnifiedExecContext::new(
+        Arc::clone(&session),
+        Arc::clone(&turn),
+        "call-early-sandbox-denied".to_string(),
+    );
+    let request = ExecCommandRequest {
+        command: vec!["demo".to_string(), "--read-only".to_string()],
+        shell_type: crate::shell::ShellType::Sh,
+        hook_command: "demo --read-only".to_string(),
+        process_id: 321,
+        yield_time_ms: 1000,
+        max_output_tokens: None,
+        #[allow(deprecated)]
+        cwd: turn.cwd.clone().into(),
+        #[allow(deprecated)]
+        sandbox_cwd: turn.cwd.clone().into(),
+        turn_environment: turn
+            .environments
+            .primary()
+            .cloned()
+            .expect("primary environment"),
+        shell_mode: codex_tools::UnifiedExecShellMode::Direct,
+        network: None,
+        tty: true,
+        sandbox_permissions: crate::sandboxing::SandboxPermissions::UseDefault,
+        additional_permissions: None,
+        additional_permissions_preapproved: false,
+        justification: None,
+        prefix_rule: None,
+    };
+    let output = ExecToolCallOutput {
+        exit_code: 0,
+        stdout: StreamOutput::new(String::new()),
+        stderr: StreamOutput::new("sandbox denied".to_string()),
+        aggregated_output: StreamOutput::new("sandbox denied".to_string()),
+        duration: Duration::from_millis(7),
+        timed_out: false,
+    };
+
+    emit_early_sandbox_denied_exec_lifecycle(
+        &context,
+        &request,
+        #[allow(deprecated)]
+        turn.cwd.clone().into(),
+        output,
+    )
+    .await;
+
+    let mut started_item = None;
+    let mut completed_item = None;
+    let mut lifecycle = Vec::new();
+    while started_item.is_none() || completed_item.is_none() {
+        let event = tokio::time::timeout(Duration::from_secs(1), rx_event.recv())
+            .await
+            .expect("timed out waiting for command execution lifecycle")
+            .expect("event channel closed");
+        match event.msg {
+            codex_protocol::protocol::EventMsg::ItemStarted(started_event) => {
+                let codex_protocol::items::TurnItem::CommandExecution(item) = started_event.item
+                else {
+                    continue;
+                };
+                assert!(
+                    started_item.replace(item).is_none(),
+                    "duplicate ItemStarted"
+                );
+                lifecycle.push("started");
+            }
+            codex_protocol::protocol::EventMsg::ItemCompleted(completed_event) => {
+                let codex_protocol::items::TurnItem::CommandExecution(item) = completed_event.item
+                else {
+                    continue;
+                };
+                assert!(
+                    completed_item.replace(item).is_none(),
+                    "duplicate ItemCompleted"
+                );
+                lifecycle.push("completed");
+            }
+            _ => {}
+        }
+    }
+
+    assert_eq!(lifecycle, ["started", "completed"]);
+
+    let started_item = started_item.expect("started command execution item");
+    assert_eq!(started_item.id, "call-early-sandbox-denied");
+    assert_eq!(
+        started_item.status,
+        codex_protocol::items::CommandExecutionStatus::InProgress
+    );
+    assert_eq!(started_item.process_id.as_deref(), Some("321"));
+    assert_eq!(started_item.exit_code, None);
+    assert_eq!(started_item.duration, None);
+
+    let completed_item = completed_item.expect("completed command execution item");
+    assert_eq!(completed_item.id, "call-early-sandbox-denied");
+    assert_eq!(
+        completed_item.status,
+        codex_protocol::items::CommandExecutionStatus::Failed
+    );
+    assert_eq!(completed_item.process_id.as_deref(), Some("321"));
+    assert_eq!(completed_item.exit_code, Some(0));
+    assert_eq!(completed_item.duration, Some(Duration::from_millis(7)));
+    assert_eq!(
+        completed_item.aggregated_output.as_deref(),
+        Some("sandbox denied")
+    );
+
+    while let Ok(Ok(event)) = tokio::time::timeout(Duration::from_millis(25), rx_event.recv()).await
+    {
+        match event.msg {
+            codex_protocol::protocol::EventMsg::ItemStarted(event)
+                if matches!(
+                    event.item,
+                    codex_protocol::items::TurnItem::CommandExecution(ref item)
+                        if item.id == "call-early-sandbox-denied"
+                ) =>
+            {
+                panic!("duplicate ItemStarted")
+            }
+            codex_protocol::protocol::EventMsg::ItemCompleted(event)
+                if matches!(
+                    event.item,
+                    codex_protocol::items::TurnItem::CommandExecution(ref item)
+                        if item.id == "call-early-sandbox-denied"
+                ) =>
+            {
+                panic!("duplicate ItemCompleted")
+            }
+            _ => {}
+        }
+    }
+}
