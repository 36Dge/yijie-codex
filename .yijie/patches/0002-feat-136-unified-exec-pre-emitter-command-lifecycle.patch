+fn assert_failed_command_lifecycle(
+    started_items: &[CommandExecutionItem],
+    completed_items: &[CommandExecutionItem],
+    lifecycle: &[&str],
+    output_delta_count: usize,
+) {
+    assert_eq!(started_items.len(), 1, "expected exactly one item/started");
+    assert_eq!(
+        completed_items.len(),
+        1,
+        "expected exactly one item/completed"
+    );
+    assert_eq!(lifecycle, ["started", "completed"]);
+    assert_eq!(output_delta_count, 0, "short denial should emit no delta");
+
+    let started = &started_items[0];
+    let completed = &completed_items[0];
+    assert_eq!(started.id, CALL_ID);
+    assert_eq!(completed.id, started.id);
+    assert_eq!(completed.process_id, started.process_id);
+    assert_eq!(started.status, CommandExecutionStatus::InProgress);
+    assert_eq!(started.exit_code, None);
+    assert_eq!(started.duration, None);
+    assert_eq!(started.aggregated_output, None);
+
+    assert_eq!(completed.status, CommandExecutionStatus::Failed);
+    assert_eq!(completed.exit_code, Some(1));
+    assert_eq!(completed.duration, Some(Duration::ZERO));
+    assert_eq!(completed.aggregated_output.as_deref(), Some(""));
