+pub(crate) const ENVIRONMENT_GATE: &str = "YIJIE_FEAT137_DETERMINISTIC_APPROVAL_PRODUCER";
+pub(crate) const EXACT_COMMAND: &str = "git rev-parse --is-inside-work-tree";
+pub(crate) const CANONICAL_CALL_ID: &str = "feat137-call-1";
+pub(crate) const CANONICAL_RESPONSE_ID: &str = "feat137-response-1";
+pub(crate) const STABLE_ADMISSION_ERROR: &str =
+    "FEAT-137 deterministic approval producer rejected an out-of-profile tool call";
+pub(crate) const STABLE_TERMINAL_ERROR: &str =
+    "FEAT-137 deterministic approval producer did not complete its required tool lifecycle";
+pub(crate) const STABLE_CONFIGURATION_ERROR: &str = "FEAT-137 deterministic approval producer requires hooks, plugins, apps, and tool search to be disabled";
+
+const TOOL_CHOICE_AUTO: &str = "auto";
+const TOOL_CHOICE_REQUIRED: &str = "required";
+const PRIVATE_EXEC_ENVIRONMENT_KEYS: [&str; 12] = [
+    "MINIMAX_API_KEY",
+    "OPENAI_API_KEY",
+    "CODEX_API_KEY",
+    "CODEX_ACCESS_TOKEN",
+    "CHATGPT_ACCESS_TOKEN",
+    "YIJIE_MINIMAX_API_KEY",
+    "YIJIE_MINIMAX_API_KEY_FILE",
+    "MINIMAX_API_KEY_FILE",
+    ENVIRONMENT_GATE,
+    "BASH_ENV",
+    "ENV",
+    "ZDOTDIR",
+];
+
+#[derive(Debug, Default)]
+pub(crate) struct TurnAdmissionState {
+    admitted_call_id: OnceLock<String>,
+    handler_entered: AtomicBool,
+    handler_finished: AtomicBool,
+    fatal: AtomicBool,
+    provider_request_count: AtomicU8,
+}
+
+#[derive(Debug, PartialEq)]
+pub(crate) struct PromptToolPlan {
+    pub(crate) tools: Vec<ToolSpec>,
+    pub(crate) tool_choice: String,
+    pub(crate) parallel_tool_calls: bool,
+}
+
+pub(crate) fn environment_gate_enabled() -> bool {
+    environment_value_enables_gate(std::env::var_os(ENVIRONMENT_GATE).as_deref())
+}
+
+pub(crate) fn shell_snapshot_capture_allowed() -> bool {
+    shell_snapshot_capture_allowed_for_gate(environment_gate_enabled())
+}
+
+pub(crate) fn provider_compaction_allowed() -> bool {
+    provider_compaction_allowed_for_gate(environment_gate_enabled())
+}
+
+fn provider_compaction_allowed_for_gate(gate_enabled: bool) -> bool {
+    !gate_enabled
+}
+
+pub(crate) fn provider_retry_limit(configured: u64) -> u64 {
+    provider_retry_limit_for_gate(environment_gate_enabled(), configured)
+}
+
+fn provider_retry_limit_for_gate(gate_enabled: bool, configured: u64) -> u64 {
+    if gate_enabled { 0 } else { configured }
+}
+
+pub(crate) fn provider_follow_up_allowed(requested: bool) -> bool {
+    provider_follow_up_allowed_for_gate(environment_gate_enabled(), requested)
+}
+
+fn provider_follow_up_allowed_for_gate(gate_enabled: bool, requested: bool) -> bool {
+    !gate_enabled && requested
+}
+
+pub(crate) fn admit_provider_request(turn: &TurnContext) -> Result<(), &'static str> {
+    admit_provider_request_for_gate(
+        environment_gate_enabled(),
+        turn.feat137_deterministic_approval.as_ref(),
+    )
+}
+
+fn admit_provider_request_for_gate(
+    gate_enabled: bool,
+    state: &TurnAdmissionState,
+) -> Result<(), &'static str> {
+    if !gate_enabled {
+        return Ok(());
+    }
+    if state
+        .provider_request_count
+        .compare_exchange(0, 1, Ordering::AcqRel, Ordering::Acquire)
+        .is_err()
+    {
+        state.fatal.store(true, Ordering::Release);
+        return Err(STABLE_TERMINAL_ERROR);
+    }
+    Ok(())
+}
+
+pub(crate) fn plugin_startup_flags(
+    plugins_enabled: bool,
+    remote_plugin_enabled: bool,
+) -> (bool, bool) {
+    plugin_startup_flags_for_gate(
+        environment_gate_enabled(),
+        plugins_enabled,
+        remote_plugin_enabled,
+    )
+}
+
+pub(crate) fn model_refresh_strategy(
+    normal: codex_models_manager::manager::RefreshStrategy,
+) -> codex_models_manager::manager::RefreshStrategy {
+    model_refresh_strategy_for_gate(environment_gate_enabled(), normal)
+}
+
+fn model_refresh_strategy_for_gate(
+    gate_enabled: bool,
+    normal: codex_models_manager::manager::RefreshStrategy,
+) -> codex_models_manager::manager::RefreshStrategy {
+    if gate_enabled {
+        codex_models_manager::manager::RefreshStrategy::Offline
+    } else {
+        normal
+    }
+}
+
+fn plugin_startup_flags_for_gate(
+    gate_enabled: bool,
+    plugins_enabled: bool,
+    remote_plugin_enabled: bool,
+) -> (bool, bool) {
+    if gate_enabled {
+        (false, false)
+    } else {
+        (plugins_enabled, remote_plugin_enabled)
+    }
+}
+
+fn shell_snapshot_capture_allowed_for_gate(enabled: bool) -> bool {
+    !enabled
+}
+
+fn environment_value_enables_gate(value: Option<&OsStr>) -> bool {
+    value == Some(OsStr::new("1"))
+}
+
+pub(crate) fn prompt_tool_plan(
+    turn: &TurnContext,
+    input: &[ResponseItem],
+    tools: Vec<ToolSpec>,
+    parallel_tool_calls: bool,
+) -> PromptToolPlan {
+    prompt_tool_plan_for_gate(
+        environment_gate_enabled(),
+        turn.feat137_deterministic_approval.as_ref(),
+        input,
+        tools,
+        parallel_tool_calls,
+    )
+}
+
+fn prompt_tool_plan_for_gate(
+    enabled: bool,
+    state: &TurnAdmissionState,
+    input: &[ResponseItem],
+    tools: Vec<ToolSpec>,
+    parallel_tool_calls: bool,
+) -> PromptToolPlan {
+    if !enabled {
+        return PromptToolPlan {
+            tools,
+            tool_choice: TOOL_CHOICE_AUTO.to_string(),
+            parallel_tool_calls,
+        };
+    }
+
+    if state.admitted_call_id.get().is_some()
+        || current_user_turn_has_exec_command(input)
+        || !has_user_turn(input)
+    {
+        return PromptToolPlan {
+            tools: Vec::new(),
+            tool_choice: TOOL_CHOICE_AUTO.to_string(),
+            parallel_tool_calls: false,
+        };
+    }
+
+    PromptToolPlan {
+        tools: vec![deterministic_exec_command_spec()],
+        tool_choice: TOOL_CHOICE_REQUIRED.to_string(),
+        parallel_tool_calls: false,
+    }
+}
+
+fn has_user_turn(input: &[ResponseItem]) -> bool {
+    input
+        .iter()
+        .any(|item| matches!(item, ResponseItem::Message { role, .. } if role == "user"))
+}
+
+fn current_user_turn_has_exec_command(input: &[ResponseItem]) -> bool {
+    let Some(last_user_message) = input
+        .iter()
+        .rposition(|item| matches!(item, ResponseItem::Message { role, .. } if role == "user"))
+    else {
+        return false;
+    };
+
+    input[last_user_message + 1..].iter().any(|item| {
+        matches!(
+            item,
+            ResponseItem::FunctionCall {
+                name,
+                namespace: None,
+                ..
+            } if name == "exec_command"
+        )
+    })
+}
+
+fn deterministic_exec_command_spec() -> ToolSpec {
+    ToolSpec::Function(ResponsesApiTool {
+        name: "exec_command".to_string(),
+        description: "Run the single deterministic FEAT-137 read-only repository check."
+            .to_string(),
+        strict: true,
+        defer_loading: None,
+        parameters: JsonSchema::object(BTreeMap::new(), Some(Vec::new()), Some(false.into())),
+        output_schema: None,
+    })
+}
+
+pub(crate) fn suppress_tool_stream_item(item: &ResponseItem) -> bool {
+    suppress_tool_stream_item_for_gate(environment_gate_enabled(), item)
+}
+
+pub(crate) fn suppress_tool_call_input_delta() -> bool {
+    environment_gate_enabled()
+}
+
+pub(crate) fn provider_boundary_state(turn: &TurnContext) -> Option<Arc<TurnAdmissionState>> {
+    environment_gate_enabled().then(|| Arc::clone(&turn.feat137_deterministic_approval))
+}
+
+pub(crate) fn validate_turn_configuration(turn: &TurnContext) -> Result<(), &'static str> {
+    if !environment_gate_enabled() {
+        return Ok(());
+    }
+    if !configuration_allowed_for_gate(
+        true,
+        turn.config.features.enabled(Feature::CodexHooks),
+        turn.config.features.enabled(Feature::Plugins),
+        turn.config.features.enabled(Feature::PluginHooks),
+        turn.config.features.enabled(Feature::Apps),
+        turn.config.features.enabled(Feature::ToolSuggest),
+    ) {
+        turn.feat137_deterministic_approval
+            .fatal
+            .store(true, Ordering::Release);
+        return Err(STABLE_CONFIGURATION_ERROR);
+    }
+    Ok(())
+}
+
+fn configuration_allowed_for_gate(
+    enabled: bool,
+    hooks: bool,
+    plugins: bool,
+    plugin_hooks: bool,
+    apps: bool,
+    tool_suggest: bool,
+) -> bool {
+    !enabled || !(hooks || plugins || plugin_hooks || apps || tool_suggest)
+}
+
+pub(crate) fn bypass_tool_hooks(turn: &TurnContext, call_id: &str, tool_name: &ToolName) -> bool {
+    environment_gate_enabled()
+        && !turn
+            .feat137_deterministic_approval
+            .fatal
+            .load(Ordering::Acquire)
+        && turn
+            .feat137_deterministic_approval
+            .admitted_call_id
+            .get()
+            .map(String::as_str)
+            == Some(call_id)
+        && tool_name.namespace.is_none()
+        && tool_name.name == "exec_command"
+}
+
+fn suppress_tool_stream_item_for_gate(enabled: bool, item: &ResponseItem) -> bool {
+    enabled && response_item_is_tool_like(item)
+}
+
+fn response_item_is_tool_like(item: &ResponseItem) -> bool {
+    matches!(
+        item,
+        ResponseItem::AdditionalTools { .. }
+            | ResponseItem::LocalShellCall { .. }
+            | ResponseItem::FunctionCall { .. }
+            | ResponseItem::ToolSearchCall { .. }
+            | ResponseItem::FunctionCallOutput { .. }
+            | ResponseItem::CustomToolCall { .. }
+            | ResponseItem::CustomToolCallOutput { .. }
+            | ResponseItem::ToolSearchOutput { .. }
+            | ResponseItem::WebSearchCall { .. }
+            | ResponseItem::ImageGenerationCall { .. }
+    )
+}
+
+pub(crate) fn sanitize_and_admit_provider_output_item(
+    state: &TurnAdmissionState,
+    item: &mut ResponseItem,
+) -> Result<(), &'static str> {
+    sanitize_and_admit_output_item_for_gate(true, state, item)
+}
+
+pub(crate) fn is_canonical_provider_output_item(item: &ResponseItem) -> bool {
+    matches!(
+        item,
+        ResponseItem::FunctionCall {
+            id: None,
+            name,
+            namespace: None,
+            arguments,
+            call_id,
+            internal_chat_message_metadata_passthrough: None,
+        } if name == "exec_command"
+            && arguments == &fixed_exec_command_arguments()
+            && call_id == CANONICAL_CALL_ID
+    )
+}
+
+pub(crate) fn verify_sanitized_output_item(
+    turn: &TurnContext,
+    item: &ResponseItem,
+) -> Result<(), &'static str> {
+    verify_sanitized_output_item_for_gate(
+        environment_gate_enabled(),
+        turn.feat137_deterministic_approval.as_ref(),
+        item,
+    )
+}
+
+fn sanitize_and_admit_output_item_for_gate(
+    enabled: bool,
+    state: &TurnAdmissionState,
+    item: &mut ResponseItem,
+) -> Result<(), &'static str> {
+    if !enabled {
+        return Ok(());
+    }
+
+    match item {
+        ResponseItem::FunctionCall {
+            id,
+            name,
+            namespace,
+            arguments,
+            call_id,
+            internal_chat_message_metadata_passthrough,
+        } if name == "exec_command"
+            && namespace.is_none()
+            && provider_call_id_is_well_formed(call_id) =>
+        {
+            // Provider-controlled identity and metadata are not execution authority.  Replace
+            // them before rollout, LastResponse, session, hook, or telemetry consumers can see
+            // the item.  This profile admits exactly one call, so one turn-local identity is
+            // sufficient for handler correlation.
+            *id = None;
+            *call_id = CANONICAL_CALL_ID.to_string();
+            *internal_chat_message_metadata_passthrough = None;
+            state.admitted_call_id.set(call_id.clone()).map_err(|_| {
+                state.fatal.store(true, Ordering::Release);
+                STABLE_ADMISSION_ERROR
+            })?;
+            *arguments = fixed_exec_command_arguments();
+            Ok(())
+        }
+        item if response_item_is_tool_like(item) => {
+            state.fatal.store(true, Ordering::Release);
+            Err(STABLE_ADMISSION_ERROR)
+        }
+        _ => Ok(()),
+    }
+}
+
+fn provider_call_id_is_well_formed(call_id: &str) -> bool {
+    !call_id.is_empty()
+        && call_id.len() <= 128
+        && call_id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'))
+}
+
+fn verify_sanitized_output_item_for_gate(
+    enabled: bool,
+    state: &TurnAdmissionState,
+    item: &ResponseItem,
+) -> Result<(), &'static str> {
+    if !enabled {
+        return Ok(());
+    }
+    match item {
+        ResponseItem::FunctionCall {
+            name,
+            namespace,
+            arguments,
+            call_id,
+            ..
+        } if name == "exec_command"
+            && namespace.is_none()
+            && state.admitted_call_id.get().map(String::as_str) == Some(call_id.as_str())
+            && arguments == &fixed_exec_command_arguments() =>
+        {
+            Ok(())
+        }
+        item if response_item_is_tool_like(item) => {
+            state.fatal.store(true, Ordering::Release);
+            Err(STABLE_ADMISSION_ERROR)
+        }
+        _ => Ok(()),
+    }
+}
+
+pub(crate) fn validate_provider_completed(state: &TurnAdmissionState) -> Result<(), &'static str> {
+    if state.fatal.load(Ordering::Acquire) || state.admitted_call_id.get().is_none() {
+        state.fatal.store(true, Ordering::Release);
+        return Err(STABLE_TERMINAL_ERROR);
+    }
+    Ok(())
+}
+
+pub(crate) fn fail_provider_stream(state: &TurnAdmissionState) {
+    state.fatal.store(true, Ordering::Release);
+}
+
+pub(crate) fn fatal_boundary_reached(turn: &TurnContext) -> bool {
+    environment_gate_enabled()
+        && turn
+            .feat137_deterministic_approval
+            .fatal
+            .load(Ordering::Acquire)
+}
+
+pub(crate) fn mark_handler_finished(turn: &TurnContext) {
+    if !environment_gate_enabled() {
+        return;
+    }
+    let state = turn.feat137_deterministic_approval.as_ref();
+    if !state.handler_entered.load(Ordering::Acquire) {
+        state.fatal.store(true, Ordering::Release);
+        return;
+    }
+    state.handler_finished.store(true, Ordering::Release);
+}
+
+pub(crate) fn validate_handler_lifecycle(turn: &TurnContext) -> Result<(), &'static str> {
+    validate_handler_lifecycle_for_gate(
+        environment_gate_enabled(),
+        turn.feat137_deterministic_approval.as_ref(),
+    )
+}
+
+fn validate_handler_lifecycle_for_gate(
+    enabled: bool,
+    state: &TurnAdmissionState,
+) -> Result<(), &'static str> {
+    if !enabled {
+        return Ok(());
+    }
+    if state.fatal.load(Ordering::Acquire)
+        || state.admitted_call_id.get().is_none()
+        || !state.handler_entered.load(Ordering::Acquire)
+        || !state.handler_finished.load(Ordering::Acquire)
+    {
+        state.fatal.store(true, Ordering::Release);
+        return Err(STABLE_TERMINAL_ERROR);
+    }
+    Ok(())
+}
+
+pub(crate) fn admitted_exec_command_arguments(
+    turn: &TurnContext,
+    call_id: &str,
+    provider_arguments: String,
+) -> Result<String, &'static str> {
+    admitted_exec_command_arguments_for_gate(
+        environment_gate_enabled(),
+        turn.feat137_deterministic_approval.as_ref(),
+        call_id,
+        provider_arguments,
+    )
+}
+
+fn admitted_exec_command_arguments_for_gate(
+    enabled: bool,
+    state: &TurnAdmissionState,
+    call_id: &str,
+    provider_arguments: String,
+) -> Result<String, &'static str> {
+    if !enabled {
+        return Ok(provider_arguments);
+    }
+    if state.fatal.load(Ordering::Acquire)
+        || state.admitted_call_id.get().map(String::as_str) != Some(call_id)
+        || state.handler_entered.swap(true, Ordering::AcqRel)
+    {
+        return Err(STABLE_ADMISSION_ERROR);
+    }
+    Ok(fixed_exec_command_arguments())
+}
+
+#[cfg(test)]
+fn exec_command_arguments_for_gate(enabled: bool, provider_arguments: String) -> String {
+    if !enabled {
+        return provider_arguments;
+    }
+    fixed_exec_command_arguments()
+}
+
+fn fixed_exec_command_arguments() -> String {
+    json!({
+        "cmd": EXACT_COMMAND,
+        "sandbox_permissions": "use_default"
+    })
+    .to_string()
+}
+
+pub(crate) fn scrub_unified_exec_environment(environment: &mut HashMap<String, String>) {
+    scrub_unified_exec_environment_for_gate(environment_gate_enabled(), environment);
+}
+
+pub(crate) fn scrub_unified_exec_environment_for_gate(
+    enabled: bool,
+    environment: &mut HashMap<String, String>,
+) {
+    if !enabled {
+        return;
+    }
+    for key in PRIVATE_EXEC_ENVIRONMENT_KEYS {
+        environment.remove(key);
+    }
+}
+
+pub(crate) fn scrub_exec_server_environment_policy(policy: &mut ExecEnvPolicy) {
+    scrub_exec_server_environment_policy_for_gate(environment_gate_enabled(), policy);
+}
+
+pub(crate) fn private_exec_environment_unset_shell() -> String {
+    private_exec_environment_unset_shell_for_gate(environment_gate_enabled())
+}
+
+pub(crate) fn private_exec_environment_unset_shell_for_gate(enabled: bool) -> String {
+    if !enabled {
+        return String::new();
+    }
+    format!("unset {}", PRIVATE_EXEC_ENVIRONMENT_KEYS.join(" "))
+}
+
+pub(crate) fn scrub_exec_server_environment_policy_for_gate(
+    enabled: bool,
+    policy: &mut ExecEnvPolicy,
+) {
+    if !enabled {
+        return;
+    }
+    for key in PRIVATE_EXEC_ENVIRONMENT_KEYS {
+        policy.r#set.remove(key);
+        if !policy.exclude.iter().any(|excluded| excluded == key) {
+            policy.exclude.push(key.to_string());
+        }
+    }
+}
