+#[tokio::test]
+async fn feat137_mapper_fails_completed_without_exact_done_for_all_partial_shapes() {
+    let cases = [
+        vec![ResponseEvent::Completed {
+            response_id: "resp-empty".to_string(),
+            token_usage: None,
+            end_turn: Some(true),
+        }],
+        vec![
