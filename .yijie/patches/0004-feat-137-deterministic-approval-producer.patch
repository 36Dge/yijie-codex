+            temp.path().join("config.toml"),
+            r#"
+[features]
+apps = false
+plugins = false
+
+[mcp_servers.ambient]
+command = "/usr/bin/true"
+"#,
+        )
+        .expect("write ordinary MCP config");
+        let config = ConfigBuilder::default()
+            .codex_home(temp.path().to_path_buf())
+            .build()
+            .await
+            .expect("build test config");
+        let plugins_manager = Arc::new(PluginsManager::new(config.codex_home.to_path_buf()));
+        let calls = Arc::new(AtomicUsize::new(0));
+        let mut extensions = ExtensionRegistryBuilder::new();
+        extensions.mcp_server_contributor(Arc::new(CountingAmbientContributor {
+            calls: Arc::clone(&calls),
+        }));
+        let manager = McpManager::new_with_extensions(
+            Arc::clone(&plugins_manager),
+            Arc::new(extensions.build()),
+        );
+
+        let gated = manager
+            .runtime_config_with_context_for_gate(
+                McpServerContributionContext::global(&config),
+                true,
+            )
+            .await;
+        assert_eq!(calls.load(Ordering::SeqCst), 0);
+        assert!(!gated.plugins_available);
+        assert!(!gated.config.apps_enabled);
+        assert!(gated.config.connector_snapshot.connector_ids().is_empty());
+        assert!(configured_names(&gated.config).is_empty());
+        assert!(effective_mcp_servers(&gated.config, /*auth*/ None).is_empty());
+
+        // With the private gate off, the unchanged composition includes the configured server
+        // and invokes the extension contributor exactly once.
+        let configured = config.to_mcp_config(plugins_manager.as_ref()).await;
+        assert_eq!(
+            configured_names(&configured),
+            BTreeSet::from(["ambient".to_string()])
+        );
+        let ungated = manager
+            .runtime_config_with_context_for_gate(
+                McpServerContributionContext::global(&config),
+                false,
+            )
+            .await;
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        assert_eq!(
+            configured_names(&ungated.config),
+            BTreeSet::from(["ambient".to_string(), "extension".to_string()])
+        );
+        assert_eq!(effective_mcp_servers(&ungated.config, None).len(), 2);
+    }
+}
