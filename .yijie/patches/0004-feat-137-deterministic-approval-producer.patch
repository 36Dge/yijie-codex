+            ResponseEvent::Completed {
+                response_id: "resp-added".to_string(),
+                token_usage: None,
+                end_turn: Some(true),
+            },
+        ],
+        vec![
+            ResponseEvent::OutputItemDone(ResponseItem::Other),
+            ResponseEvent::Completed {
+                response_id: "resp-unparseable".to_string(),
+                token_usage: None,
+                end_turn: Some(true),
+            },
+        ],
+    ];
+
+    for events in cases {
+        let state = Arc::new(crate::feat137_deterministic_approval::TurnAdmissionState::default());
+        let api_stream = futures::stream::iter(events.into_iter().map(Ok));
+        let (mut stream, _) = super::map_response_events(
+            /*upstream_request_id*/ None,
+            api_stream,
+            test_session_telemetry(),
+            InferenceTraceAttempt::disabled(),
+            test_model_provider(),
+            Some(state),
+        );
+        let mut saw_stable_failure = false;
+        while let Some(event) = stream.next().await {
+            if let Err(err) = event {
+                assert!(matches!(
+                    err,
+                    codex_protocol::error::CodexErr::Fatal(ref message)
+                        if message
+                            == crate::feat137_deterministic_approval::STABLE_TERMINAL_ERROR
+                ));
+                saw_stable_failure = true;
+            }
+        }
+        assert!(saw_stable_failure);
