+
+    struct CountingAmbientContributor {
+        calls: Arc<AtomicUsize>,
+    }
+
+    impl McpServerContributor<Config> for CountingAmbientContributor {
+        fn id(&self) -> &'static str {
+            "feat137_test_ambient"
+        }
+
+        fn contribute<'a>(
+            &'a self,
+            context: McpServerContributionContext<'a, Config>,
+        ) -> ExtensionFuture<'a, Vec<McpServerContribution>> {
+            Box::pin(async move {
+                self.calls.fetch_add(1, Ordering::SeqCst);
+                let config = context
+                    .config()
+                    .mcp_servers
+                    .get()
+                    .get("ambient")
+                    .expect("configured ambient fixture")
+                    .clone();
+                vec![McpServerContribution::Set {
+                    name: "extension".to_string(),
+                    config: Box::new(config),
+                }]
+            })
+        }
+    }
+
+    fn configured_names(config: &McpConfig) -> BTreeSet<String> {
+        configured_mcp_servers(config).into_keys().collect()
+    }
