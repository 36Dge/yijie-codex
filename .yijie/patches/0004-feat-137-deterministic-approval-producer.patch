+/// Keep exact-gate tool dispatch inert until the provider response has reached an authoritative
+/// `response.completed`.  `ToolCallRuntime::handle_tool_call` starts a Tokio task while creating
+/// its returned future, so merely boxing that future is not lazy enough.
+pub(crate) fn tool_future_for_provider_terminal<F, Fut>(
+    defer_until_terminal: bool,
+    create: F,
+) -> InFlightFuture<'static>
+where
+    F: FnOnce() -> Fut + Send + 'static,
+    Fut: Future<Output = Result<ResponseInputItem>> + Send + 'static,
+{
+    if defer_until_terminal {
+        Box::pin(async move { create().await })
+    } else {
+        Box::pin(create())
+    }
+}
