+use std::ffi::OsStr;
+
+const ENVIRONMENT_GATE: &str = "YIJIE_FEAT137_DETERMINISTIC_APPROVAL_PRODUCER";
+pub(crate) const STABLE_TRANSPORT_ERROR: &str = "FEAT-137 deterministic approval transport failed";
+
+pub(crate) fn environment_gate_enabled() -> bool {
+    environment_value_enables_gate(std::env::var_os(ENVIRONMENT_GATE).as_deref())
+}
+
+pub(crate) fn raw_diagnostic_for_gate<T>(
+    redact: bool,
+    diagnostic: impl FnOnce() -> T,
+) -> Option<T> {
+    if redact { None } else { Some(diagnostic()) }
+}
+
+fn environment_value_enables_gate(value: Option<&OsStr>) -> bool {
+    value == Some(OsStr::new("1"))
