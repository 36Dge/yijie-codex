diff --git a/codex-api/src/feat137_deterministic_approval.rs b/codex-api/src/feat137_deterministic_approval.rs
new file mode 100644
index 0000000..857ef78
--- /dev/null
+++ b/codex-api/src/feat137_deterministic_approval.rs
@@ -0,0 +1,59 @@
+use std::ffi::OsStr;
+
+const ENVIRONMENT_GATE: &str = "YIJIE_FEAT137_DETERMINISTIC_APPROVAL_PRODUCER";
+pub(crate) const STABLE_PROVIDER_STREAM_ERROR: &str =
+    "FEAT-137 deterministic approval provider stream failed";
+
+pub(crate) fn redact_provider_wire_payloads() -> bool {
+    environment_value_enables_redaction(std::env::var_os(ENVIRONMENT_GATE).as_deref())
+}
+
+pub(crate) fn stable_provider_stream_error() -> crate::error::ApiError {
+    crate::error::ApiError::Stream(STABLE_PROVIDER_STREAM_ERROR.to_string())
+}
+
+pub(crate) fn provider_stream_error_for_gate(
+    redact_wire_payload: bool,
+    raw_message: impl FnOnce() -> String,
+) -> crate::error::ApiError {
+    if redact_wire_payload {
+        stable_provider_stream_error()
+    } else {
+        crate::error::ApiError::Stream(raw_message())
+    }
+}
+
+fn environment_value_enables_redaction(value: Option<&OsStr>) -> bool {
+    value == Some(OsStr::new("1"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_exact_gate_value_enables_wire_payload_redaction() {
+        assert!(environment_value_enables_redaction(Some(OsStr::new("1"))));
+        assert!(!environment_value_enables_redaction(Some(OsStr::new(
+            "true"
+        ))));
+        assert!(!environment_value_enables_redaction(Some(OsStr::new("0"))));
+        assert!(!environment_value_enables_redaction(None));
+    }
+
+    #[test]
+    fn redacted_transport_error_never_extracts_raw_message() {
+        let raw_extracted = std::cell::Cell::new(false);
+        let error = provider_stream_error_for_gate(true, || {
+            raw_extracted.set(true);
+            "forbidden-transport-canary".to_string()
+        });
+        assert!(!raw_extracted.get());
+        let rendered = format!("{error:?}");
+        assert!(rendered.contains(STABLE_PROVIDER_STREAM_ERROR));
+        assert!(!rendered.contains("forbidden"));
+
+        let gate_off = provider_stream_error_for_gate(false, || "gate-off-byte-value".to_string());
+        assert!(format!("{gate_off:?}").contains("gate-off-byte-value"));
+    }
+}
