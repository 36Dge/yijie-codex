+            true, false, false, false, false, false
+        ));
+        assert!(!configuration_allowed_for_gate(
+            true, true, false, false, false, false
+        ));
+        assert!(!configuration_allowed_for_gate(
+            true, false, true, false, false, false
+        ));
+        assert!(!configuration_allowed_for_gate(
+            true, false, false, true, false, false
+        ));
+        assert!(!configuration_allowed_for_gate(
+            true, false, false, false, true, false
+        ));
+        assert!(!configuration_allowed_for_gate(
+            true, false, false, false, false, true
+        ));
+        assert!(shell_snapshot_capture_allowed_for_gate(false));
+        assert!(!shell_snapshot_capture_allowed_for_gate(true));
+        assert_eq!(
+            plugin_startup_flags_for_gate(true, true, true),
+            (false, false)
+        );
+        assert_eq!(
+            plugin_startup_flags_for_gate(false, true, true),
+            (true, true)
+        );
+    }
+
+    #[test]
+    fn gate_on_allows_exactly_one_provider_request_and_no_retry_compaction_or_follow_up() {
+        assert_eq!(provider_retry_limit_for_gate(true, 7), 0);
+        assert_eq!(provider_retry_limit_for_gate(false, 7), 7);
+        assert!(!provider_compaction_allowed_for_gate(true));
+        assert!(provider_compaction_allowed_for_gate(false));
+        assert!(!provider_follow_up_allowed_for_gate(true, true));
+        assert!(provider_follow_up_allowed_for_gate(false, true));
+
+        let state = TurnAdmissionState::default();
+        assert_eq!(admit_provider_request_for_gate(true, &state), Ok(()));
+        assert_eq!(
+            admit_provider_request_for_gate(true, &state),
+            Err(STABLE_TERMINAL_ERROR)
+        );
+        assert_eq!(state.provider_request_count.load(Ordering::Acquire), 1);
+        assert!(state.fatal.load(Ordering::Acquire));
+
+        let gate_off = TurnAdmissionState::default();
+        assert_eq!(admit_provider_request_for_gate(false, &gate_off), Ok(()));
+        assert_eq!(admit_provider_request_for_gate(false, &gate_off), Ok(()));
+        assert_eq!(gate_off.provider_request_count.load(Ordering::Acquire), 0);
+    }
+}
