+#[test]
+fn feat137_private_environment_cannot_be_resurrected_by_shell_snapshot() {
+    let private_keys = [
+        "MINIMAX_API_KEY",
+        "OPENAI_API_KEY",
+        "CODEX_API_KEY",
+        "CODEX_ACCESS_TOKEN",
+        "CHATGPT_ACCESS_TOKEN",
+        "YIJIE_MINIMAX_API_KEY",
+        "YIJIE_MINIMAX_API_KEY_FILE",
+        "MINIMAX_API_KEY_FILE",
+        "YIJIE_FEAT137_DETERMINISTIC_APPROVAL_PRODUCER",
+        "BASH_ENV",
+        "ENV",
+        "ZDOTDIR",
+    ];
+    let dir = tempdir().expect("create temp dir");
+    let snapshot_path = dir.path().join("snapshot.sh");
+    let snapshot = private_keys
+        .iter()
+        .map(|key| format!("export {key}='snapshot-canary'"))
+        .chain(std::iter::once("export KEEP='ordinary'".to_string()))
+        .collect::<Vec<_>>()
+        .join("\n");
+    std::fs::write(&snapshot_path, snapshot).expect("write snapshot");
+    let (session_shell, shell_snapshot) =
+        shell_with_snapshot(ShellType::Bash, "/bin/bash", snapshot_path.abs());
+    let private_key_pattern = private_keys.join("|");
+    let command = vec![
+        "/bin/bash".to_string(),
+        "-lc".to_string(),
+        format!(
+            "if env | grep -Eq '^({private_key_pattern})='; then printf leak; else printf '%s' \"$KEEP\"; fi"
+        ),
+    ];
+    let private_unsets =
+        crate::feat137_deterministic_approval::private_exec_environment_unset_shell_for_gate(true);
+    let rewritten = maybe_wrap_shell_lc_with_snapshot_and_private_unsets(
+        &command,
+        &session_shell,
+        Some(&shell_snapshot),
+        &HashMap::new(),
+        &HashMap::new(),
+        &RuntimePathPrepends::default(),
+        private_unsets.clone(),
+    );
+
+    assert!(rewritten[2].contains(&private_unsets));
+    assert!(!rewritten[2].contains("snapshot-canary"));
+    let mut process = Command::new(&rewritten[0]);
+    process.args(&rewritten[1..]);
+    for key in private_keys {
+        process.env(key, "process-canary");
+    }
+    let output = process
